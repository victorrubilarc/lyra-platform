    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@lyra/contracts": "workspace:*",
    "openai": "^6.44.0"
  },
  "devDependencies": {
    "@lyra/config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

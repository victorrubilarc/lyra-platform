{
  "name": "@lyra/licensing-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lyra-license": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@lyra/contracts": "workspace:*",
    "@lyra/licensing": "workspace:*"
  },
  "devDependencies": {
    "@lyra/config": "workspace:*",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

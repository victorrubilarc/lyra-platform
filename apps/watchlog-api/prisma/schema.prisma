// Lyra WatchLog — esquema de base de datos (Prisma)
//
// Fase 1: identidad, RBAC/ABAC, estructura organizacional y auditoría.
// Las plantillas, bitácoras, incidencias, turnos, orígenes y base de
// conocimiento se incorporan en fases posteriores. Ver docs/DATA_MODEL.md.
//
// Convenciones: PK `id` cuid; createdAt/updatedAt donde aplique; borrado
// lógico (deletedAt) en entidades de negocio; nada de secretos en claro.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
//  Identidad
// ===========================================================================

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  INVITED
}

// Modo global de requerimiento de MFA (control maestro de la política). El piso
// es OPCIONAL: nadie es forzado, pero cualquiera puede auto-enrolarse.
enum MfaMode {
  OPTIONAL
  REQUIRED_BY_ROLE
  REQUIRED_FOR_ALL
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique // siempre normalizado a minúsculas
  displayName         String
  // Hash Argon2id. Nullable para usuarios solo-OIDC a futuro (sin password local).
  passwordHash        String?
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false)
  // Obliga a cambiar la contraseña antes de operar (admin de arranque, reset admin).
  forcePasswordChange Boolean    @default(false)
  // Lockout por fuerza bruta: contador persistente + bloqueo temporal. Redis
  // se usa solo como acelerador opcional de rate-limit, no como fuente de verdad.
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  // Throttle del SEGUNDO factor (TOTP/recovery), separado del lockout de
  // contraseña: una contraseña correcta NO debe reiniciar este contador
  // (NIST 800-63B §5.2.2 / OWASP ASVS §2.2.1).
  mfaFailedCount      Int        @default(0)
  mfaLockedUntil      DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  roles           UserRole[]
  scopes          Scope[]
  templateScopes  TemplateScope[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  mfaSecret       MfaSecret?
  passwordHistory PasswordHistory[]
  resetTokens     PasswordResetToken[]
  savedViews      SavedView[]

  @@index([status])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ===========================================================================
//  Autorización — RBAC (roles/permisos) + ABAC (alcance de datos)
// ===========================================================================

enum PermissionDimension {
  MODULE
  ACTION
  WORKFLOW
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // estable, ej. "admin"
  name        String
  description String?
  // Los roles de sistema no se pueden eliminar (p. ej. Administrador).
  isSystem    Boolean  @default(false)
  // Exigir MFA a los usuarios con este rol (se honra cuando mfaMode = REQUIRED_BY_ROLE).
  requireMfa  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                   UserRole[]
  permissions             RolePermission[]
  scopes                  Scope[]
  templateScopes          TemplateScope[]
  templateSectionRoles    TemplateSectionRole[]
  templateFieldRoles      TemplateFieldRole[]
  workflowTransitionRoles WorkflowTransitionRole[]
  responsibleSchedules    LogSchedule[]
}

model Permission {
  id          String              @id @default(cuid())
  key         String              @unique // ej. "entry:create" (catálogo en @lyra/contracts)
  dimension   PermissionDimension
  group       String // agrupación para la UI de roles
  description String

  roles RolePermission[]

  @@index([dimension])
}

model UserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Alcance de datos (dimensión 4, ABAC). Sujeto polimórfico: exactamente uno de
// userId/roleId está presente (check constraint añadido en la migración).
// El alcance efectivo de un usuario = unión de sus scopes + los de sus roles.
model Scope {
  id                 String  @id @default(cuid())
  userId             String?
  roleId             String?
  orgNodeId          String
  // Si true, el alcance cubre también los descendientes del nodo.
  includeDescendants Boolean @default(true)

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  orgNode OrgNode @relation(fields: [orgNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, orgNodeId])
  @@unique([roleId, orgNodeId])
  @@index([orgNodeId])
}

// Alcance por PLANTILLA (dimensión 4, 2.º eje ABAC — Fase 2.8). Eje ORTOGONAL al
// de nodo (Scope): combina en AND ("gana la más estricta"). Sujeto polimórfico:
// exactamente uno de userId/roleId presente (check constraint en la migración).
// Semántica PERMISIVA: la AUSENCIA total de filas para un usuario (propias + de
// sus roles) significa "sin restricción de plantilla" (ve todas). Set plano: no
// hay jerarquía de plantillas (sin includeDescendants).
model TemplateScope {
  id         String  @id @default(cuid())
  userId     String?
  roleId     String?
  templateId String

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@unique([roleId, templateId])
  @@index([templateId])
}

// Asignación de PLANTILLA a NODOS de la estructura (Fase 2.8.0 — multi-nodo).
// Es el eje de NODO de la visibilidad de plantilla y FUENTE DE VERDAD ÚNICA: una
// plantilla es visible/usable en un nodo si ALGUNA de sus asignaciones lo cubre
// (el nodo, o su subárbol si `includeDescendants`). Los 3 modos del producto se
// componen de filas: un nodo (1 fila incDesc=false) · varios (N filas) · "todos
// los hijos de X" incl. nodos futuros (1 fila incDesc=true). CERO asignaciones =
// GLOBAL (visible en todo nodo), consistente con la semántica PERMISIVA del ABAC
// (ausencia = sin restricción). `Template.orgNodeId` queda DERIVADO de estas filas
// (nodo primario, deprecado; su DROP es deuda técnica — ver BACKLOG §3).
model TemplateNodeAssignment {
  id                 String  @id @default(cuid())
  templateId         String
  orgNodeId          String
  // Si true, la asignación cubre también el subárbol del nodo (incl. nodos futuros).
  includeDescendants Boolean @default(false)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  orgNode  OrgNode  @relation(fields: [orgNodeId], references: [id], onDelete: Cascade)

  @@unique([templateId, orgNodeId])
  @@index([orgNodeId])
}

// ===========================================================================
//  Sesiones y credenciales
// ===========================================================================

model Session {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

// Refresh tokens rotativos. Se guarda solo el hash; la familia (familyId)
// permite detectar reuso: si un token ya rotado se vuelve a presentar, se
// revoca toda la familia.
model RefreshToken {
  id           String    @id @default(cuid())
  sessionId    String
  userId       String
  tokenHash    String    @unique // SHA-256 del token en claro
  familyId     String // linaje de rotación
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime? // marca de rotación
  revokedAt    DateTime?
  replacedById String?   @unique

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([sessionId])
}

model MfaSecret {
  id          String    @id @default(cuid())
  userId      String    @unique
  // Secreto TOTP cifrado en reposo (AES-256-GCM con APP_ENC_KEY).
  secret      String
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]
}

model MfaRecoveryCode {
  id          String    @id @default(cuid())
  mfaSecretId String
  // Hash del código de recuperación (nunca en claro). De un solo uso.
  codeHash    String
  usedAt      DateTime?

  mfaSecret MfaSecret @relation(fields: [mfaSecretId], references: [id], onDelete: Cascade)

  @@index([mfaSecretId])
}

// Token de restablecimiento de contraseña (self-service). Se guarda SOLO el
// hash SHA-256 del token; el secreto en claro viaja una única vez en el enlace
// enviado por correo. De un solo uso (usedAt) y con expiración corta. Al pedir
// uno nuevo, o al cambiar la contraseña por cualquier vía, los pendientes se
// invalidan. Ver docs/SECURITY.md.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 del token en claro
  expiresAt DateTime
  usedAt    DateTime? // single-use: se sella al consumir
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Política de contraseñas: fila singleton (id fijo). Configurable desde la UI.
model PasswordPolicy {
  id                String   @id @default("singleton")
  minLength         Int      @default(12)
  requireUppercase  Boolean  @default(true)
  requireNumber     Boolean  @default(true)
  requireSymbol     Boolean  @default(false)
  expiryDays        Int? // null = sin expiración
  historyCount      Int      @default(5)
  maxFailedAttempts Int      @default(5)
  lockoutMinutes    Int      @default(15)
  // Requerimiento global de MFA. OPTIONAL = nadie forzado (piso).
  mfaMode           MfaMode  @default(OPTIONAL)
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

// ===========================================================================
//  Estructura organizacional
// ===========================================================================

model OrgLevel {
  id        String   @id @default(cuid())
  name      String // configurable: "Área", "Proceso", "Equipo"…
  order     Int // profundidad en la jerarquía (0 = raíz)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes OrgNode[]

  @@unique([order])
}

model OrgNode {
  id                    String    @id @default(cuid())
  name                  String
  code                  String?
  /// Descripción de uso o propósito del nodo (planta, área, unidad, etc.)
  description           String?
  /// Orden del nodo en informes/reportes, relativo a sus hermanos (asc).
  reportOrder           Int       @default(0)
  /// Código de identificación en sistemas externos (ERP, CMMS, SCADA, etc.)
  externalCode          String?
  // Calendario operacional asignado directamente a este nodo (Fase 2.3.0). Null =
  // hereda del ancestro más cercano que tenga uno, o el calendario por defecto.
  operationalCalendarId String?
  // Calendario FISCAL asignado directamente a este nodo (Fase 2.7.1.1). Null =
  // hereda del ancestro más cercano que tenga uno, o el calendario fiscal por defecto.
  fiscalCalendarId      String?
  parentId              String?
  levelId               String
  // Ruta materializada de ancestros incluyéndose: "/<id>/<id>/.../". Permite
  // consultar descendientes con `path LIKE '<prefijo>%'` en una sola query.
  path                  String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime? // borrado lógico

  level                   OrgLevel                 @relation(fields: [levelId], references: [id])
  parent                  OrgNode?                 @relation("OrgHierarchy", fields: [parentId], references: [id])
  children                OrgNode[]                @relation("OrgHierarchy")
  scopes                  Scope[]
  equipment               Equipment[]
  externalRefs            ExternalReference[]
  templates               Template[]
  templateNodeAssignments TemplateNodeAssignment[]
  logEntries              LogEntry[]
  schedules               LogSchedule[]
  incidents               Incident[]
  operationalCalendar     OperationalCalendar?     @relation(fields: [operationalCalendarId], references: [id], onDelete: SetNull)
  fiscalCalendar          FiscalCalendar?          @relation(fields: [fiscalCalendarId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([levelId])
  @@index([path])
  @@index([operationalCalendarId])
  @@index([fiscalCalendarId])
}

// ===========================================================================
//  Equipos (Equipment) y su catálogo de clasificación
// ===========================================================================

// Catálogo configurable de categorías/clases de equipo (NO enum hardcodeado).
// Mismo espíritu que OrgLevel: lo nombran y administran los clientes. `isoRef`
// permite alinear opcionalmente con una taxonomía externa (ej. clase ISO 14224).
model EquipmentCategory {
  id          String   @id @default(cuid())
  name        String
  code        String?
  isoRef      String?
  description String?
  reportOrder Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment[]
}

// Equipo industrial (máquina) anclado a un nodo de la estructura (patrón SAP PM:
// Functional Location 1:N Equipment). `deletedAt` = borrado lógico; `active` =
// estado operacional (en servicio / fuera). Integración: vía ExternalReference.
model Equipment {
  id           String    @id @default(cuid())
  name         String
  code         String?
  // assetTag estable y único: clave de negocio e identidad hacia reportes.
  tag          String?   @unique
  description  String?
  categoryId   String?
  manufacturer String?
  model        String?
  serialNumber String?
  // Criticidad 1–5 (RCM / ISO 14224); reusa la escala de severidad del DS.
  criticality  Int?
  active       Boolean   @default(true)
  // Orden en informes, relativo a los equipos del mismo nodo (asc).
  reportOrder  Int       @default(0)
  orgNodeId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // borrado lógico

  category     EquipmentCategory?  @relation(fields: [categoryId], references: [id])
  orgNode      OrgNode             @relation(fields: [orgNodeId], references: [id])
  externalRefs ExternalReference[]
  logEntries   LogEntry[]
  schedules    LogSchedule[]
  incidents    Incident[]

  @@index([orgNodeId])
  @@index([categoryId])
  @@index([deletedAt])
}

// ===========================================================================
//  Referencias externas (integration-ready) — modelo solamente (Fase 1)
// ===========================================================================

// Mapeo polimórfico de una entidad de Lyra hacia un sistema externo
// (historiador/MES/EAM). Dueño: exactamente uno de orgNodeId/equipmentId
// (check constraint en la migración — mismo patrón que Scope). Un equipo mapea a
// VARIOS sistemas a la vez. El MOTOR de sincronización es Fase 3 (Orígenes de
// datos); aquí solo vive el modelo para no migrar después. `systemType` es una
// cadena (catálogo configurable que se define en Fase 3), no un enum.
model ExternalReference {
  id           String   @id @default(cuid())
  orgNodeId    String?
  equipmentId  String?
  systemType   String // ej. "PI_WEB_API", "OPC_UA", "SAP_PM", "MAXIMO"
  externalId   String? // WebID / NodeId / Equipment Number (estable)
  externalPath String? // PI AF path / OPC browse path (legible, frágil)
  endpoint     String? // base URL / server / namespace
  metadata     Json?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgNode   OrgNode?   @relation(fields: [orgNodeId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([orgNodeId])
  @@index([equipmentId])
  @@index([systemType])
}

// ===========================================================================
//  Plantillas / Form Builder (Fase 2.1) — lado DEFINICIÓN
// ===========================================================================
//
// Paradigma (ver docs/DECISIONS.md 2026-06-09): un formulario es un proceso =
// documento vivo de SECCIONES, no una lista plana. La maquinaria enterprise
// (flujo, firma Part 11, recurrencia) es OPT-IN: una plantilla de 1 sección /
// 1 estado / sin firma se comporta como un form simple.
//
// Definición (config) vs Ejecución (registros auditados): aquí vive solo la
// DEFINICIÓN. `Template` es el contenedor lógico mutable; `TemplateVersion` es
// la versión INMUTABLE al publicar (patrón MMR de 21 CFR Part 11) — las
// entradas futuras referenciarán una versión concreta, por lo que editar la
// plantilla luego NO altera registros históricos.
//
// Las referencias a flujo/firma/recurrencia se modelan como columnas para no
// re-migrar; sus EDITORES llegan en 2.2/2.3 y las tablas de EJECUCIÓN (LogEntry…)
// en 2.4. La entidad `WorkflowDefinition` y su FK se incorporan en 2.2.

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
}

// Tipos de campo. En 2.1 tienen editor completo los 8 núcleo; SEVERITY y
// SIGNATURE quedan modelados (su comportamiento enterprise pleno —Part 11— es
// 2.5). El resto de tipos del prototipo se suma con su editor cuando toque
// (agregar valores al enum en Postgres es aditivo, no re-migra).
enum FieldType {
  NUMBER
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  BOOLEAN
  DATE
  DATETIME
  SEVERITY
  SIGNATURE
  // Catálogo de objetos premium — Ola 1 (2026-06-15). Evaluación, fecha/hora/
  // cantidad y PRESENTACIÓN (no-dato → dataType LAYOUT). Ver field-types.ts.
  CONFORMITY
  RATING
  TIME
  DURATION
  RANGE
  HEADING
  STATIC_TEXT
  DIVIDER
  NOTICE
  PROCEDURE_LINK
  REFERENCE_IMAGE
  // Catálogo de objetos premium — Ola 2 (2026-06-15). Objetos de REFERENCIA
  // (apuntan a entidades: equipo/usuario/nodo/turno vía config.entity → dataType
  // REFERENCE) y matriz de riesgo (valor estructurado → dataType RISK). Tolerancia
  // y contador son variantes de NUMBER (sin tipo nuevo). Ver field-types.ts.
  REFERENCE
  RISK_MATRIX
  // Catálogo de objetos premium — Ola 3 (2026-06-15). Adjuntos/terreno (infra
  // MinIO): foto/archivo/nota de voz/croquis, un solo tipo ATTACHMENT
  // discriminado por config.kind → dataType FILE_ARRAY (descriptor[]). El
  // escaneo QR/código NO agrega tipo (es config.scan sobre TEXT). Ver field-types.ts.
  ATTACHMENT
  // Catálogo de objetos premium — Ola 4 (2026-06-15). Objetos ESTRUCTURADOS /
  // repetibles: TABLE (tabla/grupo repetible, filas dinámicas → dataType TABLE) y
  // MATRIX (parámetro×turno, filas/columnas fijas → dataType MATRIX). Las columnas/
  // ejes son sub-campos escalares en config. Ver field-types.ts.
  TABLE
  MATRIX
}

// Recurrencia (rondas/lecturas programadas). Modelada para no re-migrar; su
// editor y la generación de ocurrencias llegan en 2.3. NONE = sin recurrencia.
enum RecurrenceKind {
  NONE
  SHIFT
  INTERVAL
  CALENDAR
}

// Tipo de periodo contable/de reporte del calendario operacional (Fase 2.3.0).
// MONTH (con día-ancla), WEEK (con día de inicio), CUSTOM (ciclo de N días op.).
enum PeriodKind {
  MONTH
  WEEK
  CUSTOM
}

// Estado de gobernanza de un período contable (Fase 2.7.1 → 2.7.1.1). Tri-estado
// industrial OPEN → CLOSED → LOCKED (backbone Maximo + NetSuite). CLOSED bloquea a
// los no privilegiados (bypass `opsperiod:write-closed`); LOCKED bloquea a TODOS
// (incl. bypass; reabrir exige `opsperiod:unlock`). CLOSING queda DEPRECADO (modelo
// lazy de 2.7.1); se conserva en el enum solo para no romper filas históricas.
enum PeriodStatus {
  OPEN
  CLOSING
  CLOSED
  LOCKED
}

// Capa 2 del campo: tipo de dato (cómo se almacena/valida/reporta), derivado del
// `type` de presentación (ver DECISIONS 2026-06-09). Enum aditivo: incluye
// valores sin productor aún (TIME/FILE/GEO/COMPUTED) para la taxonomía futura.
enum FieldDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  TIME
  CODE // un code estable de una lista (dimensión reportable)
  CODE_ARRAY // varios codes
  REFERENCE // id de una entidad (equipo/usuario/nodo/firma)
  FILE
  GEO
  COMPUTED
  RANGE // rango estructurado {from,to} de dos números (Ola 1)
  LAYOUT // objeto de PRESENTACIÓN: no es dato, el llenado lo ignora (Ola 1)
  RISK // matriz de riesgo: valor estructurado {probability,consequence} (Ola 2)
  FILE_ARRAY // varios objetos almacenados (descriptor[]) — adjuntos (Ola 3)
  TABLE // tabla/grupo repetible: valor = array de filas Record<colKey, escalar> (Ola 4)
  MATRIX // matriz parámetro×turno: valor = Record<rowKey, Record<colKey, escalar>> (Ola 4)
}

// Capa 3 del campo: rol semántico opcional (qué significa para la plataforma).
// En 2.1.1 solo EFFECTIVE_DATE tiene comportamiento (promueve LogEntry.effectiveAt
// en 2.4); el resto queda modelado. Nullable: null = sin rol.
enum FieldSemanticRole {
  EFFECTIVE_DATE
  TITLE
  PRIMARY_EQUIPMENT
  SEVERITY_DRIVER
}

// Ancla de la ventana de edición (2.7.2): desde cuándo corre el plazo de edición.
// RECORDED = desde la captura (recordedAt); EFFECTIVE = desde la fecha del evento.
enum EditWindowAnchor {
  RECORDED
  EFFECTIVE
}

// Modo de equipo por plantilla (Fase 2.8.0.2) — gobernanza del objeto de referencia
// EAM (patrón notification-type SAP PM / WO-type Maximo). El tipo de registro decide
// si el equipo se oculta / ofrece / sugiere / exige al crear la entrada.
enum EquipmentMode {
  NONE
  OPTIONAL
  SUGGESTED
  REQUIRED
}

model Template {
  id                String            @id @default(cuid())
  name              String
  description       String?
  // Ancla en la estructura (null = global). La visibilidad se filtra por scope ABAC.
  orgNodeId         String?
  status            TemplateStatus    @default(DRAFT)
  // Versión publicada "viva". Null mientras solo exista borrador.
  currentVersionId  String?           @unique
  // --- Ventana de edición (Fase 2.7.2) — GOBERNANZA VIVA en el contenedor -----
  // mutable (patrón SAP OB52 / Odoo lock dates): cambiarla aplica de inmediato a
  // todas las entradas, sin republicar la versión. null = hereda SystemSettings.
  // editWindowMinutes: null = hereda global · 0 = SIN ventana (explícito) · >0 = minutos.
  editWindowAnchor  EditWindowAnchor?
  editWindowMinutes Int?
  // --- Modo de equipo (Fase 2.8.0.2) — GOBERNANZA del objeto de referencia EAM ----
  // Vive en el contenedor MUTABLE (gobernanza viva, sin republicar). Default OPTIONAL
  // = preserva el comportamiento contextual de 2.8.0.1 para plantillas existentes.
  equipmentMode     EquipmentMode     @default(OPTIONAL)
  // --- Campos de resumen en la grilla de Bitácoras (Fase 2.8.1a) — GOBERNANZA VIVA ---
  // Pool ORDENADO de `key` de campos candidatos a mostrarse como "Resumen" en /bitacoras
  // ("el diseñador ofrece, el usuario dispone"). Keyed por el `key` ESTABLE del campo
  // (el mismo que usa LogEntryValue.fieldKey), no por la versión inmutable: cambiarlo
  // aplica en vivo a todas las entradas sin republicar (PATCH "Guardar configuración").
  // Tope 6 (validado en contrato/backend). Key huérfano (campo eliminado) = se ignora.
  gridFieldKeys     String[]          @default([])
  // Autoría (referencia blanda, sin FK: el usuario pudo borrarse — igual que AuditLog).
  createdById       String?
  updatedById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime? // borrado lógico

  orgNode         OrgNode?                 @relation(fields: [orgNodeId], references: [id], onDelete: SetNull)
  versions        TemplateVersion[]        @relation("TemplateVersions")
  currentVersion  TemplateVersion?         @relation("TemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  logEntries      LogEntry[]
  templateScopes  TemplateScope[]
  nodeAssignments TemplateNodeAssignment[]
  schedules       LogSchedule[]

  @@index([orgNodeId])
  @@index([status])
  @@index([deletedAt])
}

model TemplateVersion {
  id            String                @id @default(cuid())
  templateId    String
  versionNumber Int
  status        TemplateVersionStatus @default(DRAFT)
  // Snapshot del nombre/descripción al publicar (inmutabilidad histórica).
  name          String
  description   String?

  // --- Flujo reutilizable congelado por la versión (Fase 2.2) ---------------
  // Patrón MMR: la versión de plantilla CONGELA qué flujo y qué versión de éste
  // usa, para no alterar registros históricos. onDelete: Restrict (un histórico
  // no debe quedar sin su flujo; el borrado del flujo es lógico vía deletedAt).
  workflowDefinitionId        String?
  workflowDefinitionVersionId String?
  // Firma electrónica estilo Part 11 (opt-in a nivel de versión).
  requireSignature            Boolean        @default(false)
  // Recurrencia (rondas/turnos). Config libre validada por contrato (editor 2.3).
  recurrenceKind              RecurrenceKind @default(NONE)
  recurrenceConfig            Json?
  // Reglas de validación CRUZADA entre campos (Req-7): array de {key,when,severity,
  // message} validado por @lyra/contracts. Vive en la versión INMUTABLE (cambiar
  // una regla = nueva versión auditada, GxP). Default [] = sin reglas cruzadas.
  rules                       Json           @default("[]")

  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template                  Template                   @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentOf                 Template?                  @relation("TemplateCurrentVersion")
  sections                  TemplateSection[]
  workflowDefinition        WorkflowDefinition?        @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  workflowDefinitionVersion WorkflowDefinitionVersion? @relation(fields: [workflowDefinitionVersionId], references: [id], onDelete: Restrict)
  logEntries                LogEntry[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([status])
  @@index([workflowDefinitionId])
  @@index([workflowDefinitionVersionId])
}

// La SECCIÓN es la unidad atómica de permiso de llenado, asignación a estado del
// flujo, completitud, bloqueo y firma. `editableInStateKey` (qué estado la
// habilita) y `requireSignature` son opt-in; null/false ⇒ comportamiento simple.
model TemplateSection {
  id                 String   @id @default(cuid())
  templateVersionId  String
  // Clave estable dentro de la versión (mapeo de valores/permeabilidad).
  key                String
  title              String
  description        String?
  order              Int      @default(0)
  // Opt-in Part 11: exige firma al completar la sección (ejecución en 2.5).
  requireSignature   Boolean  @default(false)
  // Estado del flujo en que la sección es editable (referencia por clave; el
  // flujo se modela como entidad en 2.2). Null = editable siempre (form simple).
  editableInStateKey String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  version TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  fields  TemplateField[]
  // Permiso por sección: roles que pueden llenarla (asignación = dato).
  roles   TemplateSectionRole[]

  @@unique([templateVersionId, key])
  @@index([templateVersionId])
}

model TemplateField {
  id           String             @id @default(cuid())
  sectionId    String
  key          String
  // Capa 1: presentación/widget.
  type         FieldType
  // Capa 2: tipo de dato (almacenamiento/validación/reporte). Derivado del `type`
  // en backend al guardar (fuente única deriveDataType en @lyra/contracts).
  dataType     FieldDataType
  // Capa 3: rol semántico opcional. null = ninguno. Solo EFFECTIVE_DATE actúa en 2.1.1.
  semanticRole FieldSemanticRole?
  label        String
  help         String?
  required     Boolean            @default(false)
  order        Int                @default(0)
  // Config por tipo (unidad/umbral/opciones/regex…), validada por la unión Zod
  // de @lyra/contracts contra la versión. Patrón JSONB de DATA_MODEL.md.
  config       Json               @default("{}")
  // Visibilidad condicional (estilo `showIf` del prototipo): { fieldKey, equals }.
  visibleWhen  Json?
  // Campo FORMULADO (Req-7): { expression } (AST seguro de @lyra/contracts). Cuando
  // está presente el campo es READ-ONLY y su valor se DERIVA/estampa al guardar
  // (congela al sellar, GxP). null = campo tecleado normal. Versión INMUTABLE.
  computed     Json?
  // Ancho del campo en columnas de la grilla de 12 (Fase 2.1.3) — hint de
  // PRESENTACIÓN puro (SAP Fiori / ServiceNow / Bootstrap). 12 = ancho completo
  // (default, cero ruptura), 6 = media, 4 = tercio… Check 1..12 en la migración.
  colSpan      Int                @default(12)
  // Geometría EXPLÍCITA en el lienzo de posicionamiento libre (Fase 2.1.7):
  // gridX = columna (0..11), gridY = fila lógica, gridH = alto en filas (el ANCHO
  // es colSpan = w). NULLABLE: null = plantilla legacy ⇒ el editor deriva la
  // geometría del orden + colSpan y la persiste al guardar. No vive en CSS.
  gridX        Int?
  gridY        Int?
  gridH        Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  section TemplateSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Override por campo del permiso de la sección (cuando existe, manda él).
  roles   TemplateFieldRole[]

  @@unique([sectionId, key])
  @@index([sectionId])
}

// Roles autorizados a llenar una sección (granularidad por defecto).
model TemplateSectionRole {
  sectionId String
  roleId    String

  section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  role    Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([sectionId, roleId])
  @@index([roleId])
}

// Override por campo: cuando un campo declara roles, sustituyen a los de la
// sección para ese campo (editor en 2.2; aquí solo el modelo).
model TemplateFieldRole {
  fieldId String
  roleId  String

  field TemplateField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  role  Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([fieldId, roleId])
  @@index([roleId])
}

// ===========================================================================
//  Flujos reutilizables (Fase 2.2) — máquina de estados configurable
// ===========================================================================
//
// Un flujo es una MÁQUINA DE ESTADOS (estados + transiciones), NO un motor BPMN.
// Es un catálogo de primera clase, reutilizable por varias versiones de plantilla
// y referenciado/congelado por ellas. Espejo del patrón Template/TemplateVersion:
// `WorkflowDefinition` (contenedor mutable) 1—N `WorkflowDefinitionVersion`
// (INMUTABLE al publicar). La autorización POR TRANSICIÓN es DATO
// (`WorkflowTransitionRole`), no claves hardcodeadas; se honra en la EJECUCIÓN
// (2.5). Aquí vive solo la DEFINICIÓN (sin ejecución/transiciones en vivo).

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
}

model WorkflowDefinition {
  id               String         @id @default(cuid())
  key              String         @unique // estable, ej. "cierre-turno"
  name             String
  description      String?
  status           WorkflowStatus @default(DRAFT)
  // Versión publicada "viva". Null mientras solo exista borrador.
  currentVersionId String?        @unique
  createdById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime? // borrado lógico

  versions         WorkflowDefinitionVersion[] @relation("WorkflowVersions")
  currentVersion   WorkflowDefinitionVersion?  @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  // Versiones de plantilla que referencian este flujo (integridad histórica).
  templateVersions TemplateVersion[]

  @@index([status])
  @@index([deletedAt])
}

model WorkflowDefinitionVersion {
  id                   String                @id @default(cuid())
  workflowDefinitionId String
  versionNumber        Int
  status               WorkflowVersionStatus @default(DRAFT)
  // Snapshot del nombre/descripción al publicar (inmutabilidad histórica).
  name                 String
  description          String?
  publishedAt          DateTime?
  publishedById        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  definition       WorkflowDefinition   @relation("WorkflowVersions", fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  currentOf        WorkflowDefinition?  @relation("WorkflowCurrentVersion")
  states           WorkflowState[]
  transitions      WorkflowTransition[]
  // Versiones de plantilla congeladas a esta versión de flujo (no se hard-borra).
  templateVersions TemplateVersion[]

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId])
  @@index([status])
}

// Estado de la máquina. Exactamente uno isInitial; al menos uno isFinal por
// versión (validado en backend con validateWorkflowMachine de @lyra/contracts).
model WorkflowState {
  id                          String  @id @default(cuid())
  workflowDefinitionVersionId String
  key                         String // estable dentro de la versión
  name                        String
  description                 String?
  order                       Int     @default(0)
  isInitial                   Boolean @default(false)
  isFinal                     Boolean @default(false)
  // Token de color del DS para el chip (opcional).
  color                       String?
  // SLA de PERMANENCIA (Workflow SLA, 2026-06-13): tiempo máximo de estadía en este
  // estado, en MINUTOS canónicos. null = sin SLA. Viaja en la versión congelada ⇒ los
  // registros históricos conservan el SLA vigente cuando se crearon. Tiempo calendario
  // (horas hábiles = futuro). Check 1..525600 (365 d) en la migración.
  maxStayMinutes              Int?

  version  WorkflowDefinitionVersion @relation(fields: [workflowDefinitionVersionId], references: [id], onDelete: Cascade)
  outgoing WorkflowTransition[]      @relation("TransitionFrom")
  incoming WorkflowTransition[]      @relation("TransitionTo")

  @@unique([workflowDefinitionVersionId, key])
  @@index([workflowDefinitionVersionId])
}

// Transición dirigida entre dos estados de la misma versión. `requireSignature`
// (+ significado) y `requireMfa` (step-up) son opt-in y se HONRAN en ejecución
// (2.5). Los roles permitidos viven en WorkflowTransitionRole (autorización = dato).
model WorkflowTransition {
  id                          String  @id @default(cuid())
  workflowDefinitionVersionId String
  key                         String // estable dentro de la versión
  label                       String
  fromStateId                 String
  toStateId                   String
  order                       Int     @default(0)
  requireSignature            Boolean @default(false)
  signatureMeaning            String?
  requireMfa                  Boolean @default(false)

  version   WorkflowDefinitionVersion @relation(fields: [workflowDefinitionVersionId], references: [id], onDelete: Cascade)
  fromState WorkflowState             @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState   WorkflowState             @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)
  roles     WorkflowTransitionRole[]

  @@unique([workflowDefinitionVersionId, key])
  @@index([workflowDefinitionVersionId])
  @@index([fromStateId])
  @@index([toStateId])
}

// Roles autorizados a ejecutar una transición (autorización = dato, dim. 3 RBAC).
model WorkflowTransitionRole {
  transitionId String
  roleId       String

  transition WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([transitionId, roleId])
  @@index([roleId])
}

// ===========================================================================
//  Datos de referencia / Listas (Fase 2.x) — catálogo gobernado
// ===========================================================================
//
// Listas de valores reutilizables y reportables (modos de falla, turnos, causas,
// contratistas…). A diferencia de Template/Workflow, NO es versionado-inmutable:
// es un catálogo VIVO estilo Equipment/Role (code estable + activar/desactivar +
// sortOrder + borrado lógico). Ver docs/DECISIONS.md (2026-06-09).
//
// El `code` de un ítem es lo que el llenado (Fase 2.4) persiste — NO el label
// (regla de oro de reportabilidad = dimensión de DW / FHIR Coding). Un code en
// uso no se borra: se desactiva. La `key` de la lista es la clave de join que
// referencia el `optionSource.referenceList.listKey` de un campo SELECT/
// MULTISELECT (por clave estable, no FK — el config vive en JSONB). `source`
// EXTERNAL solo se MODELA; el motor de sincronización es Fase 3.

enum ReferenceSource {
  MANUAL
  EXTERNAL
}

model ReferenceList {
  id          String          @id @default(cuid())
  // Clave estable y única (slug). La referencia optionSource.referenceList.listKey.
  key         String          @unique
  name        String
  description String?
  source      ReferenceSource @default(MANUAL)
  active      Boolean         @default(true)
  // Orden de presentación del catálogo (asc).
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime? // borrado lógico

  items ReferenceItem[]

  @@index([deletedAt])
}

model ReferenceItem {
  id        String   @id @default(cuid())
  listId    String
  // Clave estable, única dentro de la lista. Es el valor que se persiste al llenar.
  code      String
  label     String
  active    Boolean  @default(true)
  // Orden de presentación en pickers, relativo a la lista (asc).
  sortOrder Int      @default(0)
  // Atributos enriquecidos (jsonb freeform): falla→{isoCategory}, contratista→{rut}…
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list ReferenceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, code])
  @@index([listId])
}

// ===========================================================================
//  Calendario operacional (turnos + periodo contable) — Fase 2.3.0
//  Config de primera clase, separada del formulario. Turno/día operacional/
//  periodo son dimensiones DERIVADAS del timestamp (ver DECISIONS 2026-06-09).
//  Catálogo GOBERNADO (no versionado-inmutable): la inmutabilidad histórica la
//  da el estampado de estas dimensiones en LogEntry (2.4).
// ===========================================================================

model OperationalCalendar {
  id                String    @id @default(cuid())
  // Clave estable y única (slug). Para seed idempotente y referencias.
  key               String    @unique
  name              String
  description       String?
  // Zona horaria IANA (ej. "America/Santiago"). Todo se guarda en UTC.
  timezone          String
  // Exactamente un calendario es el por defecto (single-tenant). Se mantiene en
  // transacción al marcar otro como default.
  isDefault         Boolean   @default(false)
  active            Boolean   @default(true)
  // Turno cuyo inicio marca el arranque del día operacional (por código, no FK:
  // los turnos se reemplazan en bloque al guardar). Null = el día arranca a las 00:00.
  // El PERÍODO contable se desacopló a FiscalCalendar en 2.7.1.1 (este calendario
  // solo gobierna turnos + día operacional).
  dayStartShiftCode String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // borrado lógico

  shifts        OperationalShift[]
  assignedNodes OrgNode[]

  @@index([deletedAt])
}

// Calendario FISCAL (período contable) — Fase 2.7.1.1. Entidad TRANSVERSAL,
// desacoplada de los turnos (ver DECISIONS 2026-06-11). Define el tipo de período
// (MONTH/WEEK/CUSTOM + ancla) con default + asignación por nodo (mismo patrón de
// resolución por ruta que OperationalCalendar). El estándar pone el período a nivel
// organización (SAP company code / Maximo Organization / NetSuite subsidiaria).
model FiscalCalendar {
  id                 String     @id @default(cuid())
  key                String     @unique
  name               String
  description        String?
  // TZ IANA para ubicar "hoy" al generar / marcar el período Actual.
  timezone           String
  isDefault          Boolean    @default(false)
  active             Boolean    @default(true)
  // Definición del período contable.
  periodKind         PeriodKind @default(MONTH)
  periodAnchorDay    Int?       @default(1) // MONTH: día civil que abre el mes (1..28)
  periodStartWeekday Int?       @default(1) // WEEK: 1=Lun..7=Dom (ISO-8601)
  periodLengthDays   Int? // CUSTOM: largo del ciclo en días operacionales
  periodAnchorDate   String? // CUSTOM: fecha de referencia "YYYY-MM-DD"
  // Rigor estricto Maximo: una fecha SIN período generado se bloquea (opt-in).
  requirePeriod      Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime? // borrado lógico

  assignedNodes OrgNode[]
  periods       OperationalPeriod[]

  @@index([deletedAt])
}

// Período contable gobernado (Fase 2.7.1 → 2.7.1.1): fila MATERIALIZADA de una llave
// de período (`periodKey`, la que estampa el FiscalResolver en LogEntry) dentro de un
// calendario FISCAL, con su rango contiguo [periodStart, periodEnd) en días
// operacionales. Generación EXPLÍCITA (no lazy): "Generar períodos" materializa filas
// contiguas idempotentes. Tri-estado OPEN→CLOSED→LOCKED. El historial completo de
// cierres/lock/reaperturas vive en AuditLog (inmutable).
model OperationalPeriod {
  id               String       @id @default(cuid())
  fiscalCalendarId String
  periodKey        String
  // Rango contiguo en días operacionales: [periodStart, periodEnd) "YYYY-MM-DD".
  periodStart      String
  periodEnd        String
  status           PeriodStatus @default(OPEN)
  // Cierre vigente.
  closedById       String?
  closedAt         DateTime?
  closeReason      String?
  // Bloqueo duro (LOCKED).
  lockedById       String?
  lockedAt         DateTime?
  lockReason       String?
  // Última reapertura (si la hubo).
  reopenedById     String?
  reopenedAt       DateTime?
  reopenReason     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  fiscalCalendar FiscalCalendar @relation(fields: [fiscalCalendarId], references: [id], onDelete: Cascade)

  @@unique([fiscalCalendarId, periodKey])
  @@index([fiscalCalendarId, status])
}

// Configuración del sistema (Fase 2.7.1.1 UX). Fila SINGLETON (id fijo "system").
// Ajustes operativos globales del single-tenant; hoy: exigir MFA para gobernar períodos.
model SystemSettings {
  id                           String           @id @default("system")
  // Re-autenticación MFA exigida POR ACCIÓN de gobernanza de período (configurable).
  requireMfaPeriodClose        Boolean          @default(false)
  requireMfaPeriodReopen       Boolean          @default(false)
  requireMfaPeriodLock         Boolean          @default(false)
  requireMfaPeriodUnlock       Boolean          @default(false)
  // --- Ventana de edición GLOBAL (Fase 2.7.2) --------------------------------
  // Fallback para plantillas sin config propia. hours null = sin ventana
  // (comportamiento pre-2.7.2). El ancla siempre tiene valor (fin de la cadena).
  editWindowAnchor             EditWindowAnchor @default(RECORDED)
  editWindowMinutes            Int?
  // Exigir re-auth con MFA al editar FUERA de ventana (override privilegiado).
  requireMfaEditWindowOverride Boolean          @default(false)
  // --- Correo saliente / SMTP (Bloque N hardening) ---------------------------
  // Config del transporte persistida en BD (editable sin reiniciar). El `.env`
  // (SMTP_*) queda como FALLBACK por campo. La contraseña va CIFRADA en reposo
  // (emailPasswordEnc) y es write-only (nunca vuelve a la UI). `emailConfiguredAt`
  // null = nunca guardada en BD ⇒ la config vigente proviene del entorno (source=env).
  emailEnabled                 Boolean          @default(false)
  emailService                 String?
  emailHost                    String?
  emailPort                    Int?
  emailSecure                  Boolean          @default(false)
  emailUser                    String?
  emailPasswordEnc             String?
  emailFromName                String?
  emailFromEmail               String?
  emailConfiguredAt            DateTime?
  emailConfiguredById          String?
  updatedById                  String?
  updatedAt                    DateTime         @updatedAt
}

model OperationalShift {
  id              String @id @default(cuid())
  calendarId      String
  // Clave estable del turno (A/B/C…), única dentro del calendario.
  code            String
  label           String
  // Hora de inicio (hora de pared local), "HH:MM".
  startTime       String
  // Duración en minutos (1..1440). Resuelve el cruce de medianoche sin ambigüedad.
  durationMinutes Int
  sortOrder       Int    @default(0)

  calendar OperationalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, code])
  @@index([calendarId])
}

// ===========================================================================
//  Programación de rondas (Fase 2.3) — recurrencia que ABRE entradas
// ===========================================================================
//
// Patrón estándar de la industria (SAP PM Maintenance Plan → calls; IBM Maximo PM →
// work orders; Hexagon j5 → schedules; ISA-95 shift handover): un HORARIO (gobernanza
// operacional VIVA, separado de la versión GxP de la plantilla) genera OCURRENCIAS
// materializadas; la ENTRADA real se crea al INICIAR la ronda (sin borradores
// huérfanos, regla 2.8.2). El enum RecurrenceKind y la lógica pura de enumeración
// viven en @lyra/contracts (enumerateOccurrences). Ver docs/DECISIONS.md 2026-06-15.

// Estado de una ocurrencia. "VENCIDA" NO es un estado: se DERIVA en consulta
// (status=PENDING AND dueAt < now()), sin cron que la voltee (igual que el SLA).
enum RoundOccurrenceStatus {
  PENDING
  COMPLETED
  SKIPPED
  CANCELED
}

// Horario de ronda: plantilla × nodo × recurrencia. Contenedor MUTABLE (gobernanza
// viva: reprogramar/pausar no republica la versión controlada). Apunta a UN nodo
// (multi-nodo/fan-out por equipo = follow-up).
model LogSchedule {
  id                   String         @id @default(cuid())
  name                 String?
  templateId           String
  orgNodeId            String
  // Equipo fijado opcionalmente (EAM). Null = sin equipo / lo elige el operador al
  // iniciar (si la plantilla exige equipo).
  equipmentId          String?
  // Rol responsable del worklist "Mis rondas" (2.3.1): el horario es del PUESTO, no de
  // una persona (work center/responsible role de SAP PM/Maximo). Null = sin responsable
  // ⇒ fallback nodo+turno (visible a todos los que alcanzan el nodo). Se lee EN VIVO:
  // reasignar el rol re-enruta las ocurrencias pendientes (no se denormaliza al slot).
  responsibleRoleId    String?
  recurrenceKind       RecurrenceKind
  // Config validada por @lyra/contracts según el kind (shiftCodes / everyMinutes+anchor
  // / times+weekdays+daysOfMonth).
  recurrenceConfig     Json
  // Minutos tras scheduledFor dentro de los que la ronda debe completarse (= dueAt).
  dueWindowMinutes     Int
  // Cuántos días hacia adelante materializa el generador idempotente.
  horizonDays          Int            @default(2)
  active               Boolean        @default(true)
  // Marca de agua: hasta qué instante (UTC) se materializaron ocurrencias. El
  // generador parte de aquí para ser idempotente y barato.
  lastGeneratedThrough DateTime?
  // Autoría (referencia blanda, sin FK dura; igual que Template/AuditLog).
  createdById          String?
  updatedById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime? // borrado lógico

  template        Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  orgNode         OrgNode           @relation(fields: [orgNodeId], references: [id], onDelete: Cascade)
  equipment       Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  responsibleRole Role?             @relation(fields: [responsibleRoleId], references: [id], onDelete: SetNull)
  occurrences     RoundOccurrence[]

  @@index([templateId])
  @@index([orgNodeId])
  @@index([responsibleRoleId])
  @@index([active, deletedAt])
}

// Ocurrencia materializada de un horario: un "slot" liviano (NO es una entrada). El
// LogEntry se crea al iniciar la ronda y queda enlazado por logEntryId (@unique).
model RoundOccurrence {
  id              String                @id @default(cuid())
  scheduleId      String
  // Denormalizados del horario (filtro/listado sin join; el horario es mutable pero
  // estos no cambian para una ocurrencia ya generada).
  templateId      String
  orgNodeId       String
  equipmentId     String?
  // Anclaje y plazo (UTC). vencida = status PENDING && dueAt < now().
  scheduledFor    DateTime
  dueAt           DateTime
  // Dimensiones operacionales estampadas al generar (ShiftResolver del nodo).
  shiftCode       String?
  operationalDate String?
  periodKey       String?
  status          RoundOccurrenceStatus @default(PENDING)
  // Entrada que cumplió la ronda (la ocurrencia POSEE el enlace; LogEntry tiene la
  // relación inversa). SetNull si la entrada se borra en duro.
  logEntryId      String?               @unique
  // Omisión (SKIPPED): quién/cuándo/por qué (auditado además en AuditLog).
  skippedById     String?
  skippedAt       DateTime?
  skipReason      String?
  generatedAt     DateTime              @default(now())

  schedule LogSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  logEntry LogEntry?   @relation(fields: [logEntryId], references: [id], onDelete: SetNull)

  // Idempotencia del generador: una sola ocurrencia por (horario, instante).
  @@unique([scheduleId, scheduledFor])
  @@index([status, dueAt])
  @@index([orgNodeId])
  @@index([templateId])
}

// ===========================================================================
//  Auditoría — append-only / inmutable (trigger en la migración)
// ===========================================================================

// ===========================================================================
//  Bitácoras / Llenado (Fase 2.4) — EJECUCIÓN auditada de una plantilla
// ===========================================================================
//
// Paradigma EBR/GxP (ver docs/DECISIONS.md 2026-06-09): definición versionada
// inmutable (TemplateVersion) vs EJECUCIÓN relacional auditada (LogEntry). La
// SECCIÓN es la unidad atómica de permiso/llenado/concurrencia/firma; captura
// multi-actor por fases resuelta por secciones × flujo × RBAC/ABAC.
//
// Forks confirmados: valores en tabla hija (LogEntryValue, 1 fila/campo) +
// historial append-only (LogEntryFieldChange); secciones instanciadas con estado
// (LogEntrySection); concurrencia optimista POR SECCIÓN (version check-and-bump);
// sellado de effectiveAt+dimensiones al ENVIAR (sealedAt).
//
// El motor de TRANSICIONES de flujo y las firmas Part 11 son 2.5: aquí la entrada
// permanece en su estado inicial. LogEntryTransition se modela en contratos pero
// su TABLA se crea en 2.5 (mismo criterio con que LogEntry se difirió a 2.4).

enum LogEntryStatus {
  DRAFT
  SUBMITTED
  VOID
}

enum LogEntrySectionState {
  PENDING
  IN_PROGRESS
  COMPLETED
  LOCKED
}

// Contexto de una firma electrónica (Part 11): transición de flujo o completitud
// de sección. Determina cuál de transitionKey/sectionKey aplica (check XOR).
enum SignatureContext {
  TRANSITION
  SECTION_COMPLETION
}

// Componentes con que se re-autenticó la firma (§11.200): contraseña sola, o
// contraseña + segundo factor (step-up AAL exigido por la transición).
enum SignatureMethod {
  PASSWORD
  PASSWORD_MFA
}

// Origen del registro (Fase 2.7.0, GxP/ALCOA+ "contemporaneous"): ONLINE =
// registrado en el momento del evento; DEFERRED = registro tardío DECLARADO por
// el operador (no inferido por relojes). La entrada tardía es legítima si queda
// identificada: fecha del evento vs fecha de captura, quién y por qué.
enum LogEntryOrigin {
  ONLINE
  DEFERRED
}

model LogEntry {
  id                          String         @id @default(cuid())
  // Folio humano correlativo (Fase 2.6): referencia estable para auditoría/terreno
  // (patrón WO number de Maximo / document number de Veeva). Lo asigna la BD; el
  // backfill de la migración lo asignó en orden de recordedAt.
  entryNumber                 Int            @unique @default(autoincrement())
  templateId                  String
  // Versión congelada que se está llenando (inmutable; integridad histórica).
  templateVersionId           String
  // Flujo DENORMALIZADO (copiado al crear). null = plantilla sin flujo (form simple).
  workflowDefinitionId        String?
  workflowDefinitionVersionId String?
  // Alcance/dimensiones de sistema (columnas indexadas).
  orgNodeId                   String
  equipmentId                 String?
  // Estado del flujo (clave dentro de la versión congelada). null = sin flujo.
  currentStateKey             String?
  status                      LogEntryStatus @default(DRAFT)
  // Marca de captura (commit), inmutable.
  recordedAt                  DateTime       @default(now())
  // Fecha efectiva de negocio (campo EFFECTIVE_DATE; fallback recordedAt).
  effectiveAt                 DateTime       @default(now())
  // Dimensiones operacionales estampadas vía ShiftResolver (nullable = sin calendario).
  shiftCode                   String?
  operationalDate             String? // "YYYY-MM-DD" (día operacional, fecha local)
  periodKey                   String?
  // Instante en que se congelaron effectiveAt + dimensiones (al enviar). null = DRAFT.
  sealedAt                    DateTime?
  // Momento de ENTRADA al estado actual (Workflow SLA, 2026-06-13): seteado al crear
  // (= recordedAt) y en cada transición (= occurredAt). Es la base de cómputo del
  // ATRASO (now − currentStateSince > maxStayMinutes del estado actual). Estampado
  // aditivo que evita la subconsulta MAX(transición). null solo en filas pre-migración
  // sin backfill (el backfill lo derivó de la última transición o recordedAt).
  currentStateSince           DateTime?
  // --- Registro diferido (Fase 2.7.0) ---------------------------------------
  // Origen DECLARADO del registro (default ONLINE; ver enum LogEntryOrigin).
  entryOrigin                 LogEntryOrigin @default(ONLINE)
  // Fecha/hora REAL del evento declarada a NIVEL DE ENTRADA. Es el fallback
  // intermedio de resolveEffectiveAt (campo EFFECTIVE_DATE → declarada →
  // recordedAt); si la plantilla tiene campo EFFECTIVE_DATE, el gesto lo
  // escribe y ese campo sigue mandando.
  declaredEffectiveAt         DateTime?
  // Motivo del diferimiento (obligatorio al declarar; práctica GxP late entry).
  deferredReason              String?
  // Quién y cuándo declaró el diferimiento (huella ALCOA+ / timeline).
  deferredDeclaredById        String?
  deferredDeclaredAt          DateTime?
  // --- Anulación de borrador (Fase 2.8.2, VOID) -----------------------------
  // Anulación LÓGICA de un borrador (status=VOID): NO hard-delete y NO usa
  // deletedAt (ese campo oculta la fila de TODA consulta, incl. el filtro VOID);
  // aquí la entrada queda trazable (status VOID, fuera de las superficies normales
  // pero recuperable por filtro). Quién/cuándo/por qué; el AuditLog conserva el rastro.
  voidedAt                    DateTime?
  voidReason                  String?
  voidedById                  String?
  // Autoría (referencia blanda, sin FK dura; igual que Template/AuditLog).
  createdById                 String?
  updatedById                 String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  deletedAt                   DateTime? // borrado lógico / anulación

  template        Template              @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  orgNode         OrgNode               @relation(fields: [orgNodeId], references: [id], onDelete: Restrict)
  equipment       Equipment?            @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  sections        LogEntrySection[]
  values          LogEntryValue[]
  changes         LogEntryFieldChange[]
  transitions     LogEntryTransition[]
  signatures      LogEntrySignature[]
  // Ronda programada que originó esta entrada (Fase 2.3). null = entrada manual.
  // El enlace lo posee la ocurrencia (RoundOccurrence.logEntryId @unique); aquí solo
  // la relación inversa, sin columna duplicada.
  roundOccurrence RoundOccurrence?

  @@index([templateId])
  @@index([templateVersionId])
  @@index([orgNodeId])
  @@index([equipmentId])
  @@index([status])
  @@index([currentStateKey])
  // Orden POR DEFECTO del listado (recordedAt desc) con desempate por id: índice
  // COMPUESTO para que la paginación keyset sea un seek por índice a cualquier escala.
  @@index([recordedAt, id])
  // effectiveAt es el otro orden disponible; compuesto con id por el mismo motivo.
  @@index([effectiveAt, id])
  @@index([effectiveAt])
  @@index([operationalDate])
  @@index([periodKey])
  @@index([createdById])
  @@index([entryOrigin])
  @@index([deletedAt])
}

// Sección INSTANCIADA: porta el ESTADO de ejecución que no se puede derivar de la
// plantilla (completitud, autoría, firma, revisión de concurrencia).
model LogEntrySection {
  id                String               @id @default(cuid())
  logEntryId        String
  // Clave estable de la sección dentro de la versión congelada.
  sectionKey        String
  state             LogEntrySectionState @default(PENDING)
  filledById        String?
  filledAt          DateTime?
  // Firma de completitud de la sección (Part 11), si la sección la exige.
  // Referencia blanda a LogEntrySignature.id (la firma es append-only y cuelga de
  // la entrada por logEntryId+context+sectionKey; este puntero es de conveniencia).
  signatureId       String?
  // ¿La definición congelada exige firma de completitud? ESTAMPADO al instanciar
  // (Fase 2.6) para que "firmas pendientes" sea un filtro SQL barato
  // (requiresSignature = true AND signatureId IS NULL) sin join a la definición.
  requiresSignature Boolean              @default(false)
  // Revisión para la concurrencia optimista POR SECCIÓN (check-and-bump).
  version           Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@unique([logEntryId, sectionKey])
  @@index([logEntryId])
}

// Banda de umbral ISA-18.2 en que cayó un valor numérico (Fase 2.6). Se estampa
// al guardar (la validación ya la computa) contra la definición CONGELADA:
// habilita review-by-exception (filtros/KPIs de "fuera de umbral") sin re-evaluar.
enum ThresholdBand {
  WARN
  CRIT
}

// Valor actual de un campo (1 fila por campo). El de un campo de referencia se
// persiste como `code` estable, NO como label (dimensión de DW / FHIR Coding).
model LogEntryValue {
  id            String         @id @default(cuid())
  logEntryId    String
  // Sección a la que pertenece el campo (para la concurrencia por sección).
  sectionKey    String
  fieldKey      String
  // Tipo de dato copiado (reportabilidad sin re-leer la versión congelada).
  dataType      FieldDataType
  // code / code[] / número / booleano / fecha ISO / etc. null = vacío.
  value         Json?
  // Banda de umbral en que cayó el valor al guardarse (null = en rango / no aplica).
  thresholdBand ThresholdBand?
  updatedById   String?
  updatedAt     DateTime       @updatedAt

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@unique([logEntryId, fieldKey])
  @@index([logEntryId])
  @@index([sectionKey])
  // Casi todo null: índice pequeño que acelera el semi-join de "fuera de umbral".
  @@index([thresholdBand])
}

// Historial append-only por campo (antes/después). Auditoría fina del llenado;
// complementa el AuditLog de eventos de alto nivel (creación/envío de la entrada).
model LogEntryFieldChange {
  id          String   @id @default(cuid())
  logEntryId  String
  fieldKey    String
  before      Json?
  after       Json?
  reason      String?
  changedById String?
  changedAt   DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
  @@index([changedAt])
}

// Transición de flujo EJECUTADA sobre una entrada (Fase 2.5). Historial
// append-only: trazabilidad ALCOA+ de cómo avanzó el registro entre estados.
// Las claves (from/to/transition) son las de la VERSIÓN CONGELADA del flujo.
model LogEntryTransition {
  id                          String   @id @default(cuid())
  logEntryId                  String
  // Versión de flujo congelada bajo la que se ejecutó (integridad histórica).
  workflowDefinitionVersionId String
  transitionKey               String
  fromStateKey                String
  toStateKey                  String
  // Actor (referencia blanda + snapshot del correo; el usuario puede borrarse).
  actorId                     String?
  actorEmail                  String?
  reason                      String?
  // Firma asociada (si la transición la exigía). Referencia blanda a la firma.
  signatureId                 String?
  occurredAt                  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId, occurredAt])
}

// Firma electrónica estilo 21 CFR Part 11 (§11.50/11.70/11.200). Entidad de
// primer orden, POLIMÓRFICA por `context`: firma de una transición de flujo o de
// la completitud de una sección. Guarda el nombre impreso del firmante, el
// significado, el método de re-auth y el SHA-256 del snapshot canónico firmado
// (record–signature linking: integridad/no repudio sin almacenar el snapshot).
model LogEntrySignature {
  id            String           @id @default(cuid())
  logEntryId    String
  context       SignatureContext
  // Exactamente uno aplica según `context` (check XOR en la migración).
  transitionKey String?
  sectionKey    String?
  // Firmante (referencia blanda + nombre impreso capturado al firmar, §11.50).
  signerId      String?
  signerName    String
  meaning       String
  method        SignatureMethod
  // SHA-256 (hex) del payload canónico firmado.
  payloadHash   String
  signedAt      DateTime         @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
  @@index([signerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  // Snapshot del actor (puede haberse borrado el usuario; por eso no es FK dura).
  actorId    String?
  actorEmail String?
  action     String // ej. "auth.login.success", "user.role.assigned"
  entityType String? // ej. "User", "Role", "OrgNode"
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  metadata   Json?

  @@index([occurredAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

// Vista guardada de PLATAFORMA (Fase 2.8.1b). Entidad genérica reusable por
// cualquier módulo de listado (Bitácoras hoy; Incidencias en Fase 4) vía el
// discriminador `module`. Es DATO PERSONAL del usuario (no RBAC): la autorización
// es por OWNERSHIP (userId === actor), no por permiso del catálogo. `config` es
// JSONB validado por Zod en el contrato (no columnas por atributo: el universo de
// presentación es abierto y heterogéneo). Las vistas de SISTEMA viven en código,
// no aquí. Compartir por rol queda DIFERIDO (aditivo: futuros scope/sharedRoleId).
model SavedView {
  id        String   @id @default(cuid())
  // Dueño. Borrado en cascada con el usuario (su preferencia muere con él).
  userId    String
  // Discriminador de módulo de listado. Ej. "LOGBOOK". String (no enum) para no
  // migrar el esquema al sumar módulos; el contrato valida el conjunto vigente.
  module    String
  name      String
  // Snapshot de presentación: {filters, search, sort[], columns{order,hidden,pinned,widths}, density}.
  config    Json
  // UNA default por (userId, module): índice único PARCIAL `WHERE isDefault`
  // (se crea a mano en la migración; Prisma no expresa unicidad parcial).
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
}

// === Notificaciones (Bloque N) ===============================================
// Motor de avisos por correo. Cinco entidades, todas con referencias BLANDAS
// (String indexado, sin FK dura — patrón AuditLog) para que la migración sea
// 100% ADITIVA: no toca User/Role ni ninguna tabla existente. El catálogo de
// EVENTOS vive en código (@lyra/contracts NOTIFICATION_EVENTS), no en BD.

enum NotificationChannel {
  EMAIL
}

enum NotificationEventStatus {
  PENDING
  DISPATCHED
  FAILED
}

// Estado de una orden de acción de regla (Fase 4.1.2). DONE = ejecutada (excepción/
// incidencia creada o ya existente por dedupe); FAILED = agotó reintentos.
enum RuleActionOutboxStatus {
  PENDING
  DONE
  FAILED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum NotificationMode {
  IMMEDIATE
  DIGEST
  OFF
}

// Cola transaccional (etapa 1 del transactional outbox): el cambio de dominio (o
// el sweeper) inserta un evento MÍNIMO (ids en payload) en su MISMA transacción;
// el dispatcher resuelve destinatarios + renderiza FUERA de la tx (etapa 2). Un
// crash entre commit y envío no pierde el evento.
model NotificationEvent {
  id           String                  @id @default(cuid())
  eventKey     String
  // IDs y datos crudos para resolver destinatarios + contexto de render.
  payload      Json
  // Dedup de eventos DERIVED (una ronda vencida = UN evento aunque el sweeper la
  // re-vea cada tick). Null en tx-driven (cada disparo es legítimo; NULLs distintos).
  dedupeKey    String?                 @unique
  status       NotificationEventStatus @default(PENDING)
  attempts     Int                     @default(0)
  lastError    String?
  createdAt    DateTime                @default(now())
  dispatchedAt DateTime?

  @@index([status, createdAt])
}

// Bandeja de salida (etapa 2) = registro de cada mensaje a CADA destinatario +
// la "pantalla de correo saliente" (Req-1/Req-5). El cuerpo renderizado se
// persiste (snapshot) para auditoría.
model NotificationOutbox {
  id                String                   @id @default(cuid())
  eventId           String?
  eventKey          String
  channel           NotificationChannel      @default(EMAIL)
  recipientUserId   String?
  recipientEmail    String
  subject           String
  bodyText          String
  bodyHtml          String
  status            NotificationOutboxStatus @default(PENDING)
  attempts          Int                      @default(0)
  lastError         String?
  nextAttemptAt     DateTime?
  // Dedup por destinatario: p. ej. round.overdue|{occurrenceId}|{userId}.
  dedupeKey         String?                  @unique
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime                 @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([eventKey, createdAt])
  @@index([recipientUserId])
}

// Plantilla de mensaje (gobernanza viva). Una por (evento, locale, canal). Las de
// sistema se siembran por defecto; el admin las edita pero no las borra.
model NotificationTemplate {
  id          String              @id @default(cuid())
  eventKey    String
  locale      String
  channel     NotificationChannel @default(EMAIL)
  subject     String
  bodyText    String
  bodyHtml    String
  active      Boolean             @default(true)
  isSystem    Boolean             @default(false)
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([eventKey, locale, channel])
}

// Suscripción explícita (watcher): usuario XOR rol se suscribe a un evento, con
// filtro opcional por nodo (incl. descendientes) / plantilla.
model NotificationSubscription {
  id                 String   @id @default(cuid())
  eventKey           String
  subjectUserId      String?
  subjectRoleId      String?
  orgNodeId          String?
  includeDescendants Boolean  @default(false)
  templateId         String?
  enabled            Boolean  @default(true)
  createdById        String?
  createdAt          DateTime @default(now())

  @@index([eventKey])
  @@index([subjectUserId])
  @@index([subjectRoleId])
}

// Preferencia personal (ownership): modo de entrega de un evento×canal por usuario.
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  eventKey  String
  channel   NotificationChannel @default(EMAIL)
  mode      NotificationMode    @default(IMMEDIATE)
  updatedAt DateTime            @updatedAt

  @@unique([userId, eventKey, channel])
  @@index([userId])
}

// ===========================================================================
//  Incidencias operacionales / HSE (Fase 4.0) — núcleo
// ===========================================================================
//
// Single-tenant: el aislamiento es por NODO/PLANTILLA (ABAC), NUNCA por tenant.
// El CICLO DE VIDA reutiliza WorkflowDefinition (Fase 2.2): la incidencia CONGELA
// una versión de flujo (denormalizada, patrón LogEntry) y avanza por sus
// transiciones con las mismas guardas (rol-dato + firma Part 11 opt-in). El
// `lifecycle` se mantiene denormalizado (OPEN/CLOSED/CANCELED) para filtros/KPIs
// baratos. Sin borrado físico: anulación = lifecycle CANCELED con motivo. Las
// referencias a usuario/flujo/entrada son BLANDAS (sin FK, patrón AuditLog).

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentOrigin {
  MANUAL
  LOG_ENTRY
  EXCEPTION
  RULE
}

enum IncidentLifecycle {
  OPEN
  CLOSED
  CANCELED
}

// Catálogo configurable de TIPOS (con flags de comportamiento). El flujo por
// defecto que se congela al crear es referencia BLANDA al WorkflowDefinition.
model IncidentType {
  id                    String   @id @default(cuid())
  key                   String   @unique // estable, ej. "falla-equipo"
  name                  String
  description           String?
  color                 String? // token del DS para el chip
  defaultWorkflowId     String? // WorkflowDefinition que se congela al crear (ref. blanda)
  requiresInvestigation Boolean  @default(false)
  requiresCapa          Boolean  @default(false)
  reportableDefault     Boolean  @default(false)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  categories IncidentCategory[]
  incidents  Incident[]

  @@index([active])
  @@index([deletedAt])
}

// Catálogo configurable de CATEGORÍAS (subtipos), opcionalmente colgadas de un tipo.
model IncidentCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  typeId      String? // null = categoría transversal
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  type      IncidentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  incidents Incident[]

  @@index([typeId])
  @@index([active])
  @@index([deletedAt])
}

model Incident {
  id          String           @id @default(cuid())
  // Folio humano correlativo (patrón entryNumber/WO number). El código "INC-####"
  // se DERIVA en el backend a partir de este número.
  number      Int              @unique @default(autoincrement())
  title       String
  description String?
  typeId      String
  categoryId  String?
  // Escala 1..5 (tokens severidad). potentialSeverity = potencial de gravedad (MPL).
  severity         Int
  potentialSeverity Int?
  priority         IncidentPriority  @default(MEDIUM)
  // Riesgo ISO 31000 (ejes de la matriz RISK_MATRIX; nivel se deriva con riskLevelFor).
  riskProbability  Int?
  riskConsequence  Int?
  originType       IncidentOrigin    @default(MANUAL)
  lifecycle        IncidentLifecycle @default(OPEN)
  // --- Ciclo de vida por flujo (reusa WorkflowDefinition; ref. denormalizada) ---
  workflowDefinitionId        String?
  workflowDefinitionVersionId String?
  currentStateKey             String? // clave del estado actual dentro de la versión congelada
  // Momento de entrada al estado actual (base del cómputo de SLA de permanencia).
  currentStateSince           DateTime @default(now())
  // --- Alcance / ligazón (referencias blandas salvo nodo/equipo/catálogo) -------
  orgNodeId       String
  equipmentId     String?
  shiftCode       String?
  // Origen desde una entrada de bitácora (ref. blanda; 4.1 agrega excepciones).
  originLogEntryId String?
  // Fecha/hora en que OCURRIÓ el evento (ISO 14224 / HSE), distinta de `createdAt`
  // (cuándo se REPORTÓ): en terreno se reporta tarde. Null = no declarada (cae a createdAt).
  occurredAt      DateTime?
  // --- Personas (ref. blanda + snapshot de nombre en el timeline) ---------------
  reporterId  String?
  ownerId     String?
  // --- SLA / cierre -------------------------------------------------------------
  dueAt          DateTime?
  reportable     Boolean   @default(false)
  closedAt       DateTime?
  closedById     String?
  closureSummary String?
  // --- Anulación (sin borrado físico) -------------------------------------------
  canceledAt   DateTime?
  cancelReason String?
  canceledById String?
  createdById  String?
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  type       IncidentType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  category   IncidentCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orgNode    OrgNode              @relation(fields: [orgNodeId], references: [id], onDelete: Restrict)
  equipment  Equipment?           @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  comments   IncidentComment[]
  activities IncidentActivity[]
  transitions IncidentTransition[]
  exceptionLinks IncidentExceptionLink[]

  @@index([typeId])
  @@index([categoryId])
  @@index([orgNodeId])
  @@index([equipmentId])
  @@index([lifecycle])
  @@index([priority])
  @@index([severity])
  @@index([ownerId])
  @@index([originType])
  @@index([originLogEntryId])
  @@index([currentStateKey])
  @@index([createdAt, id])
}

// Comentario de gestión (append-only en la práctica; editar/borrar = futuro).
model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String?
  authorName String? // snapshot del nombre impreso
  body       String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

// Timeline APPEND-ONLY: creación, asignación, cambio de severidad/prioridad,
// transición de estado, comentario, cierre, anulación. `kind` clasifica el evento.
model IncidentActivity {
  id         String   @id @default(cuid())
  incidentId String
  kind       String // CREATED|ASSIGNED|FIELD_CHANGED|TRANSITION|COMMENT|CLOSED|CANCELED
  summary    String
  actorId    String?
  actorName  String?
  metadata   Json?
  occurredAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
}

// === Excepciones operacionales desde bitácoras (Fase 4.1) =====================

enum ExceptionTrigger {
  THRESHOLD_WARN
  THRESHOLD_CRIT
  RULE
  MANUAL
}

enum ExceptionThresholdType {
  warning
  critical
  invalid
}

enum ExceptionStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
  CONVERTED
  CORRECTED
}

// Materialización de una anomalía de bitácora (umbral WARN/CRIT, regla WARN,
// registro manual) con ESTADO y TRIAGE. El contexto se CONGELA en la detección
// (no se re-deriva): refs BLANDAS a entrada/nodo/equipo/operador/plantilla
// (patrón AuditLog/Incident), sin FK que ate la entrada. El valor ORIGINAL nunca
// se pierde; una corrección lo preserva (GxP). Una incidencia agrupa N excepciones.
model LogEntryException {
  id     String @id @default(cuid())
  // Folio humano correlativo. El código "EXC-####" se DERIVA en el backend.
  number Int    @unique @default(autoincrement())
  // --- Origen del dato (contexto congelado; refs blandas) -----------------------
  logEntryId        String
  templateId        String?
  templateVersionId String?
  // NULL en excepciones de REGLA cruzada (Fase 4.1.2): no atan un campo único.
  sectionKey        String?
  sectionLabel      String?
  fieldKey          String?
  fieldLabel        String?
  fieldType         String?
  unit              String?
  // Referencia a la celda de una TABLE/MATRIX (MVP: nivel de campo, suele null).
  occurrenceRef     String?
  // --- Valor (jsonb; el original es INMUTABLE) ----------------------------------
  originalValue Json?
  bandsSnapshot Json? // {warnLow,warnHigh,critLow,critHigh} efectivas en la detección
  // --- Disparador ---------------------------------------------------------------
  triggerKind   ExceptionTrigger
  thresholdType ExceptionThresholdType
  ruleKey       String?
  ruleVersionId String?
  ruleSeverity  String?
  detail        String? // descripción legible (regla/manual)
  // --- Operacional (denormalizado; refs blandas) --------------------------------
  orgNodeId     String
  equipmentId   String?
  shiftCode     String?
  operatorId    String?
  detectedAt    DateTime  @default(now())
  entrySealedAt DateTime?
  // --- Triage -------------------------------------------------------------------
  status        ExceptionStatus @default(OPEN)
  triagedById   String?
  triagedAt     DateTime?
  dismissReason String?
  // --- Corrección (GxP: el original arriba NUNCA se pierde) ----------------------
  correctedValue  Json?
  correctionReason String?
  correctedById   String?
  correctedAt     DateTime?
  // --- Ligazón (N:1 denormalizado para filtros rápidos; el link table es la fuente) -
  incidentId String?
  // Idempotencia: una sola excepción viva por (entrada, campo, ocurrencia, disparador).
  dedupeKey  String? @unique
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links IncidentExceptionLink[]

  @@index([logEntryId])
  @@index([orgNodeId])
  @@index([equipmentId])
  @@index([status])
  @@index([thresholdType])
  @@index([incidentId])
  @@index([detectedAt, id])
}

// Join AUTORITATIVO excepción↔incidencia (N:1 en MVP: @@unique(exceptionId)).
// Carga la PROVENIENCIA del enlace (quién/cuándo), que el `incidentId`
// denormalizado de la excepción no registra. Cascade desde ambos lados.
model IncidentExceptionLink {
  id          String   @id @default(cuid())
  incidentId  String
  exceptionId String
  linkedById  String?
  linkedAt    DateTime @default(now())

  incident  Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  exception LogEntryException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@unique([exceptionId])
  @@index([incidentId])
}

// Outbox transaccional DEDICADO para las ACCIONES del motor de reglas (Fase 4.1.2):
// cuando una regla cruzada con acción dispara al SELLAR una entrada, se encola UNA
// orden DENTRO de la tx del sello (atómica; no se pierde ante un crash post-commit)
// y un worker la ejecuta DIFERIDA (crea la excepción RULE / abre la incidencia), de
// modo que una automatización NO pueda bloquear ni revertir el sello del operador.
//
// Tabla PROPIA (no se reusa NotificationEvent, específico de correo): "crear un
// objeto de dominio" ≠ "avisar a alguien". `dedupeKey` = rule:{entryId}:{ruleKey}
// garantiza una sola materialización por (entrada, regla) aunque se re-encole.
model RuleActionOutbox {
  id            String                 @id @default(cuid())
  // Refs BLANDAS (patrón AuditLog): la orden sobrevive aunque la entrada se anule.
  logEntryId    String
  ruleKey       String
  // Versión congelada donde vive la regla (TemplateVersion.rules); el worker lee de ahí.
  ruleVersionId String?
  // Snapshot de los valores que dispararon la regla (contexto GxP para la excepción).
  payload       Json
  status        RuleActionOutboxStatus @default(PENDING)
  attempts      Int                    @default(0)
  lastError     String?
  // Una sola orden por (entrada, regla): idempotencia ante re-sello / re-encolado.
  dedupeKey     String                 @unique
  // Quién selló (actor que origina la reacción; para ABAC + auditoría del worker).
  actorId       String?
  createdAt     DateTime               @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
}

// Transición de flujo EJECUTADA sobre una incidencia (append-only; integridad
// histórica: claves de la versión CONGELADA). Espejo de LogEntryTransition.
model IncidentTransition {
  id                          String   @id @default(cuid())
  incidentId                  String
  workflowDefinitionVersionId String
  transitionKey               String
  fromStateKey                String
  toStateKey                  String
  actorId                     String?
  actorEmail                  String?
  reason                      String?
  signatureId                 String? // ref. blanda a LogEntrySignature (firma Part 11)
  occurredAt                  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
}

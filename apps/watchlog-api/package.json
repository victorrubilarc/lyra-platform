{
  "name": "@lyra/watchlog-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:backfill-descriptions": "dotenv -e ../../.env -- tsx prisma/backfill-node-descriptions.ts",
    "db:backfill-report-order": "dotenv -e ../../.env -- tsx prisma/backfill-report-order.ts",
    "db:backfill-threshold-bands": "dotenv -e ../../.env -- tsx prisma/backfill-threshold-bands.ts",
    "db:migrate-fiscal": "dotenv -e ../../.env -- tsx prisma/migrate-fiscal.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@lyra/contracts": "workspace:*",
    "@lyra/llm": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@types/nodemailer": "^8.0.0",
    "argon2": "^0.41.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^8.0.10",
    "otplib": "^12.0.1",
    "pdfmake": "^0.3.11",
    "pino-http": "^10.4.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lyra/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.7",
    "@types/pdfmake": "^0.3.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

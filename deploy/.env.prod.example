# ============================================================================
#  Lyra WatchLog — .env de PRODUCCIÓN (AWS). Copia a `deploy/.env` en el host y
#  rellena los valores. NUNCA subas este .env al repositorio.
#  Genera los secretos con:  openssl rand -base64 48   (claves) /  -base64 32 (AES)
# ============================================================================

# === Distribución (imágenes GHCR publicadas por release.yml) ===
WL_REGISTRY=ghcr.io
WL_OWNER=__TU_USUARIO_U_ORG_DE_GITHUB__   # ej: victorrubilarc (dueño del repo en minúsculas)
WL_VERSION=stable                          # update.sh la sobreescribe con el tag (vX.Y.Z)
TZ=America/Santiago

# === Dominio público (lo enruta el Caddy de BORDE compartido de ruta-bus) ===
# DNS: lyra.watchlog.itesicws.com  → IP del EC2. El TLS lo emite el Caddy de borde.
APP_PUBLIC_URL=https://lyra.watchlog.itesicws.com

# === PostgreSQL (contenedor DEDICADO a WatchLog) ===
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=__GENERAR_32+__
POSTGRES_DB=watchlog
# OJO: host = nombre del servicio `postgres` (no localhost), literal (env_file no sustituye).
DATABASE_URL=postgresql://watchlog:__MISMA_PASS__@postgres:5432/watchlog?schema=public

# === Redis (servicio `redis`) ===
REDIS_URL=redis://redis:6379

# === MinIO (servicio `minio`; evidencias/adjuntos) ===
MINIO_ROOT_USER=watchlog
MINIO_ROOT_PASSWORD=__GENERAR__
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=watchlog
MINIO_SECRET_KEY=__GENERAR__
MINIO_BUCKET=watchlog-evidence
MINIO_REGION=us-east-1
MINIO_PRESIGN_TTL=300

# === App / API ===
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
PLANT_TIME_ZONE=America/Santiago
PASSWORD_RESET_TTL=1800
REFERENCE_IMPORT_MAX_ROWS=5000

# === Auth (Fase 1) — SECRETOS ROBUSTOS ===
AUTH_PROVIDERS=local
JWT_ACCESS_SECRET=__GENERAR_48+__
JWT_REFRESH_SECRET=__GENERAR_48+__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# HTTPS en el borde ⇒ DEBE ser true (cookie de refresh Secure).
COOKIE_SECURE=true
# Cookie host-only (un subdominio): dejar SIN COOKIE_DOMAIN.
# COOKIE_DOMAIN=
APP_ENC_KEY=__GENERAR_BASE64_32__
DATA_SOURCE_ENC_KEY=__GENERAR_BASE64_32__

# === Admin de arranque (solo se usa si RUN_SEED=true en el primer deploy) ===
BOOTSTRAP_ADMIN_EMAIL=admin@itesicws.cl
BOOTSTRAP_ADMIN_PASSWORD=__CAMBIAR_FUERTE__

# === SMTP (fallback de arranque; la config real se administra en la app) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lyra WatchLog <no-reply@itesicws.cl>"

# === Branding del frontend (no secreto; horneado en el build de la imagen web) ===
VITE_LICENSEE_NAME=ITESICWS

# === IA administrable (fallback; se configura en la app /configuracion) ===
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# ============================================================================
#  Lyra WatchLog — .env de PLANTA (paquete AIR-GAPPED / standalone).
#
#  NO edites esta plantilla a mano en la planta: el instalador `install.sh` la
#  copia a `.env`, GENERA los secretos con openssl (los tokens __GEN_*__) y te
#  pide completar SOLO lo específico del sitio (APP_PUBLIC_URL + EDGE_MODE).
#  Los __GEN_*__ jamás quedan en el .env final; si ves uno, install.sh no corrió.
#  El .env resultante lleva chmod 600 (secretos en reposo). NUNCA lo subas a git.
# ============================================================================

# === Imagen (air-gap: nombre NEUTRO, sin registry/owner) =====================
# Vacío ⇒ las imágenes cargadas por `docker load` se llaman lyra-watchlog-*:<tag>.
# (Solo si algún día se tira por GHCR: WL_IMAGE_PREFIX=ghcr.io/<owner>/)
WL_IMAGE_PREFIX=
WL_VERSION=__WL_VERSION__            # install.sh la fija con el tag del paquete
TZ=America/Santiago

# === Borde (elige UN modo; ver README.md / INSTALL_OFFLINE.md) ===============
#   a = detrás del proxy DEL CLIENTE (F5/NetScaler/NGINX/IIS termina TLS)   [preferido]
#   b = borde PROPIO con certificado corporativo montado (sin ACME, air-gap)
#   c = borde compartido del demo (NO aplica en planta)
EDGE_MODE=__SET_ME_EDGE_MODE__       # a | b   ← COMPLETAR
EDGE_LOCAL_PORT=8080                 # solo modo (a): loopback 127.0.0.1:<port>

# === Dominio público (el usuario SIEMPRE llega por HTTPS del borde) ==========
APP_PUBLIC_URL=__SET_ME_APP_PUBLIC_URL__   # ej: https://watchlog.planta.interna  ← COMPLETAR
COOKIE_SECURE=true                   # HTTPS en el borde ⇒ true en los 3 modos
# COOKIE_DOMAIN=                      # host-only (un subdominio): dejar sin definir

# === PostgreSQL (contenedor DEDICADO) ========================================
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=__GEN_DB_PASSWORD__
POSTGRES_DB=watchlog
DATABASE_URL=postgresql://watchlog:__GEN_DB_PASSWORD__@postgres:5432/watchlog?schema=public

# === Redis ===================================================================
REDIS_URL=redis://redis:6379

# === MinIO (evidencias/adjuntos; 100% INTERNO, nunca expuesto) ===============
MINIO_ROOT_USER=watchlog
MINIO_ROOT_PASSWORD=__GEN_MINIO_PASSWORD__
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=watchlog
MINIO_SECRET_KEY=__GEN_MINIO_PASSWORD__
MINIO_BUCKET=watchlog-evidence
MINIO_REGION=us-east-1

# === Rate limiting global (H1; contadores en Redis, por IP real) =============
# Defaults seguros incorporados (300/60s · auth 10/60s · públicos 30/60s ·
# subida 30/300s). Descomentar SOLO si muchos usuarios comparten un NAT interno.
#THROTTLE_DEFAULT_LIMIT=300
#THROTTLE_AUTH_LIMIT=10
#THROTTLE_PUBLIC_LIMIT=30
#THROTTLE_UPLOAD_LIMIT=30

# === App / API ===============================================================
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
PLANT_TIME_ZONE=America/Santiago
PASSWORD_RESET_TTL=1800
REFERENCE_IMPORT_MAX_ROWS=5000

# === Auth — SECRETOS ROBUSTOS (generados por install.sh) =====================
AUTH_PROVIDERS=local
JWT_ACCESS_SECRET=__GEN_JWT_ACCESS__
JWT_REFRESH_SECRET=__GEN_JWT_REFRESH__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
APP_ENC_KEY=__GEN_APP_ENC_KEY__
DATA_SOURCE_ENC_KEY=__GEN_DATA_SOURCE_ENC_KEY__

# === Primer administrador ====================================================
# NO se configura aquí: al primer arranque la app deja un token de un solo uso
# en ./license/setup-token y el asistente web (/setup) crea el administrador.

# === Respaldo pre-migración ==================================================
# El upgrade offline respalda la BD antes de migrar (forward-only). true = si el
# backup falla, ABORTA antes de tocar el esquema (red de seguridad).
BACKUP_REQUIRED=true

# === SMTP (opcional; la config real se administra en la app) =================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lyra WatchLog <no-reply@localhost>"

# === IA administrable (opcional; se configura en la app /configuracion) ======
# Air-gap: usar proveedor local (openai-compatible a un modelo on-prem) o none.
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=

# Borde PROPIO de Lyra WatchLog (modo b) — TLS con certificado montado en /certs.
# Sin ACME (air-gap): el cert es self-signed autogenerado o el de la CA de la planta.
#
# ⚠ REFERENCIA/EJEMPLO. En el paquete offline, `install.sh` REGENERA este archivo
#   desde APP_PUBLIC_URL en cada corrida (host + default_sni solo si es IP): el
#   operador NO lo edita a mano. Para cambiar el dominio, edita APP_PUBLIC_URL en
#   .env y reejecuta ./install.sh.
{
	# Air-gap: sin ACME, sin telemetría, sin puertos de administración.
	auto_https off
	admin off
}

# Redirect 80 → 443 (quitar este bloque si el equipo de redes no quiere :80).
http://watchlog.planta.cliente.local {
	redir https://{host}{uri} permanent
}

https://watchlog.planta.cliente.local {
	tls /certs/cert.pem /certs/key.pem

	encode gzip zstd

	# X-Forwarded-For lo agrega Caddy automáticamente (la API lo usa para el
	# rate limit por IP y la IP real de la auditoría).
	reverse_proxy watchlog-web:80
}

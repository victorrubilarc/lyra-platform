# syntax=docker/dockerfile:1
# ----------- Backend NestJS (watchlog-api) -----------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
# OpenSSL: Prisma lo necesita para elegir el motor de consultas correcto en
# runtime (bookworm-slim no lo trae). ca-certificates para TLS salientes (SMTP/IA).
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo

# ---- Instala dependencias (cacheable por manifiestos) ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
# Copia el package.json de TODOS los paquetes del workspace (no solo los que el
# api importa): `pnpm install --frozen-lockfile` necesita el grafo completo, y el
# api depende de @lyra/llm (sus deps —SDKs de IA— deben instalarse). Antes faltaba
# `llm` ⇒ el build del api fallaba al resolver @lyra/llm.
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/licensing/package.json packages/licensing/
# licensing-cli es devDependency del api (envoltorio license:dev): su manifiesto
# es necesario para el grafo de pnpm, pero el paquete JAMÁS llega a la imagen
# runtime (deploy --prod excluye devDependencies; es la herramienta del EMISOR).
COPY packages/licensing-cli/package.json packages/licensing-cli/
COPY packages/llm/package.json packages/llm/
COPY packages/permissions/package.json packages/permissions/
COPY packages/ui/package.json packages/ui/
COPY apps/watchlog-api/package.json apps/watchlog-api/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts

# ---- Compila contratos + API y genera cliente Prisma ----
FROM deps AS build
COPY . .
# Compila TODOS los paquetes del workspace (contracts, llm, …) antes del api —
# el api importa @lyra/llm ya compilado. Equivale al `predev` del monorepo.
RUN pnpm --filter "./packages/**" run build \
 && pnpm --filter @lyra/watchlog-api exec prisma generate \
 && pnpm --filter @lyra/watchlog-api build
# --- Licenciamiento L5 · anti-tamper (SOLO en el build de imagen; dev/ci.yml no
# --- pasan por aquí, LICENSING_PROCEDURE §6). Empaqueta la API en UN único
# --- dist-bundle/main.js minificado con nombres destruidos, INLINEA el módulo
# --- crítico @lyra/licensing (deja de ser texto editable) y SELLA el artefacto
# --- (SHA-256 embebido) para la auto-verificación de integridad del runtime.
# --- Se cuelga del MISMO punto donde el release ya horneó la pública de PROD.
RUN node scripts/license/bundle-api.mjs \
 && node scripts/license/seal-integrity.mjs apps/watchlog-api/dist-bundle/main.js
# Empaqueta el API con solo sus dependencias de producción. `--legacy`: pnpm v10+
# exige inject-workspace-packages para `deploy` por defecto; con --legacy usa el
# modo clásico (copia el paquete + sus deps de prod, incl. los @lyra/* compilados).
# `dangerouslyAllowAllBuilds`: el /app standalone NO hereda el `onlyBuiltDependencies`
# del workspace ⇒ sin esto pnpm 11 BLOQUEA los builds nativos (argon2, prisma) y
# falla sin TTY. Contexto de build confiable (deps propias), así que se permite.
RUN pnpm --filter @lyra/watchlog-api deploy --prod --legacy --config.dangerouslyAllowAllBuilds=true /app
# --- L5 · en el /app desplegado: sustituye el dist LEGIBLE (un .js por archivo,
# --- con el árbol de licensing en claro) por el bundle ÚNICO sellado, y borra
# --- el fuente TypeScript (src/tools) y la copia legible del módulo crítico
# --- (@lyra/licensing quedó inlineado en el bundle ⇒ ya no se requiere). Así la
# --- imagen distribuida no reparte la lógica de licencia en texto editable.
RUN cp apps/watchlog-api/dist-bundle/main.js /tmp/main.sealed.js \
 && rm -rf /app/dist /app/dist-bundle /app/src /app/tools /app/nest-cli.json \
           /app/tsconfig.json /app/tsconfig.build.json /app/vitest.config.ts \
           /app/eslint.config.mjs /app/node_modules/@lyra/licensing \
 && find /app/prisma -name '*.ts' -delete \
 && mkdir /app/dist \
 && mv /tmp/main.sealed.js /app/dist/main.js
# --- E2 · sin fuga de fuente: el runtime del api NO siembra (eso es la imagen
# --- `migrate`), así que los seeds/backfills TypeScript de prisma/ son fuente
# --- muerta aquí. Se borran (se conservan schema.prisma + migrations/ para el
# --- `prisma generate` de runtime). Verificado: 0 .ts fuera de node_modules.

# ---- Imagen final ----
FROM base AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
# Regenera el cliente Prisma en la estructura FINAL de /app. El `prisma generate`
# del `pnpm deploy` quedó en una ubicación que @prisma/client NO resuelve en
# runtime (pnpm coloca @prisma/client en .pnpm/ y el cliente generado se pierde),
# y el api crasheaba con "@prisma/client did not initialize yet". Regenerar aquí
# (schema + CLI ya están en /app, openssl en base) lo deja donde el api lo busca.
RUN node_modules/.bin/prisma generate
# CIS Docker 4.1 (H2 2026-07-07) — el proceso corre como NON-ROOT. La base
# node:22-bookworm-slim ya trae el usuario `node` (uid 1000). El runtime SOLO
# lee /app (root:root 755, legible/ejecutable por node); lo único que ESCRIBE es
# /app/license (bind-mount rw — el host lo deja a uid 1000 vía install.sh/update.sh)
# y /tmp (tmpfs del compose). /etc/machine-id se monta :ro (world-readable). El
# `prisma generate` de arriba corrió como root, así que el cliente ya está listo.
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]

# ---- Imagen de MIGRACIONES (init container) ----
# Reusa el stage `build` (que SÍ tiene devDeps: el CLI de Prisma + tsx + las
# migraciones + el seed). La imagen runtime de arriba se arma con `pnpm deploy
# --prod` y NO incluye el CLI de Prisma, por eso las migraciones van en una
# imagen aparte (patrón "migrate" init container). Aplica `migrate deploy`
# (idempotente, no destructivo) y el seed de CATÁLOGO en CADA deploy
# (SEED_SCOPE=catalog: permisos/plantillas/flujos base; idempotente y JAMÁS
# crea usuarios — así los permisos nuevos de cada versión llegan a las
# instalaciones existentes). El primer administrador lo crea el asistente de
# primer arranque (/setup), no el seed (OOBE 2026-07-06; RUN_SEED retirado).
FROM build AS migrate
ENV NODE_ENV=production
WORKDIR /repo/apps/watchlog-api
# --- L5 + E2 · la imagen migrate es un toolchain (prisma CLI + tsx + seed) que
# --- viaja al cliente pero se construye `FROM build` (que hizo `COPY . .`) ⇒ sin
# --- poda, cargaría CASI TODO el monorepo en claro (frontend watchlog-web,
# --- packages/*/src, scripts de licencia con la llave DEV, docs, prototipo…). Se
# --- PODA AGRESIVAMENTE a lo mínimo que necesitan `migrate deploy` + `seed.ts`:
# ---   · el fuente del módulo crítico @lyra/licensing (no lo importa el seed)
# ---   · TODO el frontend `watchlog-web` (el seed jamás lo toca)
# ---   · el `src` de cada package (se conserva su `dist` compilado, que es lo que
# ---     resuelven los imports @lyra/* del seed; @lyra/contracts es el único que usa)
# ---   · `scripts/` (bundle/seal/embed + dev-private.pem), `tools/gen-dev-license`,
# ---     docs, deploy, docker, prototipo, notas, y los backfills/one-off de prisma
# ---     que el seed NO importa (backfill-*, migrate-fiscal) + specs/tests.
# --- Se CONSERVA: prisma/ (seed.ts + *-seed-data.ts + structure-descriptions +
# --- report-order que el seed SÍ importa), schema + migrations, node_modules,
# --- package.json/tsconfig del api, y el `dist` de cada package. `; true`:
# --- idempotente aunque una ruta no exista. Verificado: 0 fuente Lyra fuera de
# --- node_modules tras la poda (E2 2026-07-07).
RUN rm -rf /repo/packages/licensing \
           /repo/apps/watchlog-api/src /repo/apps/watchlog-api/dist \
           /repo/apps/watchlog-api/dist-bundle \
           /repo/node_modules/@lyra/licensing \
           /repo/apps/watchlog-api/node_modules/@lyra/licensing \
           /repo/apps/watchlog-web \
           /repo/packages/contracts/src \
           /repo/packages/config /repo/packages/llm /repo/packages/permissions \
           /repo/packages/ui /repo/packages/licensing-cli \
           /repo/scripts /repo/docs /repo/deploy /repo/docker \
           /repo/apps/watchlog-api/tools /repo/apps/watchlog-api/test \
           /repo/apps/watchlog-api/vitest.config.ts \
           /repo/prototipo.tsx /repo/ideas.txt /repo/prompt_x_sesion.md \
           /repo/README.md /repo/claude.md /repo/CLAUDE.md \
           /repo/apps/watchlog-api/prisma/backfill-node-descriptions.ts \
           /repo/apps/watchlog-api/prisma/backfill-report-order.ts \
           /repo/apps/watchlog-api/prisma/backfill-threshold-bands.ts \
           /repo/apps/watchlog-api/prisma/migrate-fiscal.ts 2>/dev/null; \
    find /repo -name '*.spec.ts' -delete 2>/dev/null; \
    find /repo -name '*.test.ts' -delete 2>/dev/null; \
    true
# CIS Docker 4.1 (H2 2026-07-07) — el init de migraciones también corre NON-ROOT
# (uid 1000 `node`). La poda de arriba fue como root; el CMD solo LEE /repo (root:root
# 755) y escribe en /tmp (tmpfs + TMPDIR): `prisma migrate deploy` (engine que solo
# lee node_modules) y `tsx` (compila el seed en memoria/TMPDIR). El seed únicamente
# hace upserts contra Postgres, no escribe en disco. TMPDIR=/tmp fija dónde escribe tsx.
ENV TMPDIR=/tmp
USER node
# Invoca los binarios DIRECTO (no `pnpm exec`): con NODE_ENV=production, `pnpm exec`
# intenta reconciliar node_modules a solo-producción (poda tsx/prisma CLI) y, sin
# TTY, aborta con ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY. Los .bin ya existen
# en la imagen (deps instaladas en el stage build).
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && SEED_SCOPE=catalog node_modules/.bin/tsx prisma/seed.ts"]

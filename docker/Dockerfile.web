# syntax=docker/dockerfile:1
# ----------- Frontend React (watchlog-web) servido por Caddy -----------
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @lyra/contracts build \
 && pnpm --filter @lyra/watchlog-web build

# ---- Caddy sirve los estáticos y proxea /api ----
FROM caddy:2-alpine AS runtime
COPY docker/Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /repo/apps/watchlog-web/dist /srv
EXPOSE 80 443

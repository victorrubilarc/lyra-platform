# syntax=docker/dockerfile:1
# ----------- Frontend React (watchlog-web) servido por Caddy -----------
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
# Metadatos de versión (los pasa el release como build-args desde el tag git). Vite los
# inyecta en build vía `define` (ver vite.config.ts) para mostrarlos en «Acerca de».
ARG VITE_APP_VERSION
ARG VITE_GIT_SHA
ARG VITE_BUILD_DATE
ENV VITE_APP_VERSION=$VITE_APP_VERSION VITE_GIT_SHA=$VITE_GIT_SHA VITE_BUILD_DATE=$VITE_BUILD_DATE
RUN pnpm --filter @lyra/contracts build \
 && pnpm --filter @lyra/watchlog-web build

# ---- Caddy sirve los estáticos y proxea /api ----
FROM caddy:2-alpine AS runtime
COPY docker/Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /repo/apps/watchlog-web/dist /srv
# CIS Docker 4.1 (H2 2026-07-07) — Caddy como uid 1000 NON-ROOT. Caddy escribe en
# /data y /config (XDG del image oficial), que el compose provee por tmpfs (el Caddy
# interno es stateless: no hace ACME, el TLS lo pone el borde). El bind de :80/:443
# NO usa CAP_NET_BIND_SERVICE: el compose habilita el sysctl
# net.ipv4.ip_unprivileged_port_start=0 ⇒ compatible con cap_drop:[ALL] +
# no-new-privileges (una file-capability con setcap la bloquearía no-new-privileges).
RUN addgroup -g 1000 -S app && adduser -u 1000 -S -G app -H app
USER app
EXPOSE 80 443

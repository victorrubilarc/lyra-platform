# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-bundle/
build/
.vite/
*.tsbuildinfo

# Prisma generated client
**/generated/
**/.prisma/

# Tests / coverage
coverage/

# Env & secrets
.env
.env.*
!.env.example
!deploy/.env.prod.example
!deploy/standalone/.env.standalone.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Docker volumes (si se montan localmente)
docker/volumes/

# Backups de Postgres generados en el host (nunca al repo)
/deploy/backups/*
!/deploy/backups/.gitkeep

# Licencias locales (license.lic dev + solicitud.lreq). Las llaves DEV committeadas
# viven en scripts/license/dev-keys (esas SÍ van al repo; no son secreto).
.license/

# Custodia del EMISOR (Licenciamiento L3): la clave PRIVADA de PROD, su
# passphrase y el ledger viven FUERA del repo (~/.lyra-license). Estas reglas
# son la red de seguridad por si alguien los copiara adentro por error. La
# ÚNICA privada committeada es la DEV (scripts/license/dev-keys, no-secreto).
*.enc.pem
prod-private*
.lyra-license/
ledger.jsonl

# Firma de imágenes (E3 · cosign): la clave PRIVADA de firma vive FUERA del repo
# (~/.lyra-license/cosign/) y como GitHub Secret; JAMÁS committeada. La PÚBLICA
# (cosign.pub) SÍ va al repo — no es secreto, sirve para verificar. Red de seguridad:
cosign.key
*.cosign.key
# Backups cifrados (E3 · age): la identidad PRIVADA la custodia el CLIENTE fuera
# del host; si alguna quedara en el árbol por error, no debe committearse.
backup-identity*.txt
*.age

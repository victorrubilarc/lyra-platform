# ============================================================
#  Lyra WatchLog — variables de entorno (plantilla)
#  Copia este archivo a `.env` y ajusta los valores.
#  NUNCA subas `.env` al repositorio.
# ============================================================

# === App ===
NODE_ENV=development
LOG_LEVEL=debug

# === API ===
API_PORT=3000

# === PostgreSQL ===
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=watchlog
POSTGRES_DB=watchlog
DATABASE_URL=postgresql://watchlog:watchlog@localhost:5432/watchlog?schema=public

# === Redis (caché de orígenes, rate-limit, colas) ===
REDIS_URL=redis://localhost:6379

# === MinIO (evidencias, firmas, adjuntos) ===
MINIO_ROOT_USER=watchlog
MINIO_ROOT_PASSWORD=watchlogsecret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=watchlog-evidence

# === SMTP (opcional; en dev se usa Mailpit en localhost:1025) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lyra WatchLog <no-reply@watchlog.local>"

# === Auth (Fase 1) ===
# Proveedores de autenticación activos (coma). Hoy solo "local"; OIDC/LDAP se
# enchufan por configuración en fases posteriores sin tocar el código.
AUTH_PROVIDERS=local
# Genera secretos robustos, ej: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=900          # segundos (15 min)
JWT_REFRESH_TTL=2592000     # segundos (30 días)
# Cookie del refresh token. En producción DEBE ser true (requiere HTTPS).
COOKIE_SECURE=false
# COOKIE_DOMAIN=watchlog.miempresa.cl
# Clave AES-256-GCM para cifrar secretos en reposo (TOTP). 32 bytes en base64:
#   openssl rand -base64 32
APP_ENC_KEY=changeme-base64-32-bytes
# Clave para cifrar credenciales de orígenes de datos en reposo (Fase 3)
DATA_SOURCE_ENC_KEY=changeme-base64-32-bytes

# Admin de arranque: el seed crea este usuario con rol Administrador y le exige
# cambiar la contraseña en el primer login. Vacío = el seed no crea admin.
BOOTSTRAP_ADMIN_EMAIL=admin@watchlog.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# === Branding del frontend (empresa licenciataria, single-tenant) ===
# Co-branding de la pantalla de acceso: cada instalación on-premise se licencia
# a una empresa. Estos valores son del build de la web (prefijo VITE_) y NO son
# secretos. Si no hay logo, se usa un monograma con las iniciales del nombre.
VITE_LICENSEE_NAME=Eagon Lautaro Ltda.
# VITE_LICENSEE_INDUSTRY=Minería
# VITE_LICENSEE_LOGO_URL=/branding/cliente-logo.svg

# === IA (Fase 5; proveedor intercambiable) ===
AI_PROVIDER=none            # none | anthropic | openai | gemini | deepseek | local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=                # para modelo local (Ollama/vLLM), ej: http://localhost:11434

# === Producción (Caddy / TLS automático) ===
# SITE_ADDRESS=watchlog.miempresa.cl   # dominio para HTTPS automático; vacío = :80

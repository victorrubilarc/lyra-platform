# ============================================================
#  Lyra WatchLog — variables de entorno (plantilla)
#  Copia este archivo a `.env` y ajusta los valores.
#  NUNCA subas `.env` al repositorio.
# ============================================================

# === App ===
NODE_ENV=development
LOG_LEVEL=debug

# === API ===
API_PORT=3000

# === PostgreSQL ===
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=watchlog
POSTGRES_DB=watchlog
DATABASE_URL=postgresql://watchlog:watchlog@localhost:5432/watchlog?schema=public

# === Redis (caché de orígenes, rate-limit, colas) ===
REDIS_URL=redis://localhost:6379

# === MinIO (evidencias, firmas, adjuntos) ===
# Storage de objetos on-prem tras la interfaz abstracta StorageService. La API es
# el choke-point de subida (proxied) y firma las descargas (presigned GET); el
# navegador NUNCA recibe estas credenciales ni accede directo al bucket.
MINIO_ROOT_USER=watchlog
MINIO_ROOT_PASSWORD=watchlogsecret
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=watchlog
MINIO_SECRET_KEY=watchlogsecret
MINIO_BUCKET=watchlog-evidence
MINIO_REGION=us-east-1

# === Rate limiting global (H1; contadores en Redis, por IP real) ===
# `default` generoso para toda la API; `auth`/`public`/`upload` estrictos solo en
# sus rutas. Salud y SSE están exentos. Defaults seguros: cambiar solo con motivo.
#THROTTLE_DEFAULT_LIMIT=300
#THROTTLE_DEFAULT_TTL_S=60
#THROTTLE_AUTH_LIMIT=10
#THROTTLE_AUTH_TTL_S=60
#THROTTLE_PUBLIC_LIMIT=30
#THROTTLE_PUBLIC_TTL_S=60
#THROTTLE_UPLOAD_LIMIT=30
#THROTTLE_UPLOAD_TTL_S=300

# === SMTP (correo saliente; en dev se usa Mailpit en localhost:1025) ===
# Tras la interfaz abstracta EmailService. On-premise: el relay del cliente.
# NOTA: esto es solo el FALLBACK de arranque. La config del correo se administra
# en la app (Configuración ▸ Correo saliente, permiso notification:config) y se
# guarda en BD (contraseña CIFRADA); una vez guardada ahí, manda la BD, no el .env.
SMTP_HOST=localhost
SMTP_PORT=1025
# TLS implícito (puerto 465) = true. STARTTLS (587) o Mailpit (1025) = false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lyra WatchLog <no-reply@watchlog.local>"

# === Recuperación de contraseña / enlaces por correo ===
# URL pública de la web (single-tenant): base para construir enlaces enviados por
# correo. En dev, el servidor de Vite; en prod, el dominio detrás de Caddy.
APP_PUBLIC_URL=http://localhost:5173
# Vida del token de restablecimiento, en segundos (def. 30 min).
PASSWORD_RESET_TTL=1800
# Tope de filas por import CSV de listas de referencia (def. 5000).
REFERENCE_IMPORT_MAX_ROWS=5000
# Zona horaria de PLANTA para el bucketing temporal del dashboard de incidencias (Fase 4.5).
# Single-tenant on-prem ⇒ una sola TZ (no se infiere del navegador). Def. America/Santiago.
PLANT_TIME_ZONE=America/Santiago

# === Auth (Fase 1) ===
# Proveedores de autenticación activos (coma). Hoy solo "local"; OIDC/LDAP se
# enchufan por configuración en fases posteriores sin tocar el código.
AUTH_PROVIDERS=local
# Genera secretos robustos, ej: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=900          # segundos (15 min)
JWT_REFRESH_TTL=2592000     # segundos (30 días)
# Cookie del refresh token. En producción DEBE ser true (requiere HTTPS).
COOKIE_SECURE=false
# COOKIE_DOMAIN=watchlog.miempresa.cl
# Clave AES-256-GCM para cifrar secretos en reposo (TOTP). 32 bytes en base64:
#   openssl rand -base64 32
APP_ENC_KEY=changeme-base64-32-bytes
# Clave para cifrar credenciales de orígenes de datos en reposo (Fase 3)
DATA_SOURCE_ENC_KEY=changeme-base64-32-bytes

# El admin de arranque por variables (BOOTSTRAP_ADMIN_*) fue RETIRADO (OOBE,
# 2026-07-06): el primer administrador lo crea el asistente de primer arranque
# (/setup) con el token de instalación de un solo uso. El seed no crea usuarios
# en producción; en dev el usuario demo lo crea el seed de alcance "demo".

# === Branding del frontend ===
# Las variables VITE_LICENSEE_* fueron RETIRADAS (OOBE S3, 2026-07-06): el
# co-branding (nombre + logo de la empresa) ahora es RUNTIME — se captura en el
# asistente de primer arranque (/setup) o en /configuracion ▸ Identidad y se
# aplica sin rebuild (GET /api/branding). La misma imagen sirve a N clientes.

# === IA administrable (Fase 5 · Slice 2) ===
# La IA se administra DESDE LA APP (tab "Inteligencia Artificial" en /configuracion,
# permiso ai:config); la config se guarda en BD y la API key va CIFRADA. Estas variables
# son SOLO FALLBACK de arranque, si nunca se guardó config en la app.
AI_ENABLED=false            # true | false
AI_PROVIDER=none            # none | anthropic | openai-compatible
AI_MODEL=                   # ej: claude-opus-4-8 (anthropic) o qwen2.5:7b-instruct (local)
# Solo para openai-compatible (Ollama/vLLM/LM Studio/OpenAI/DeepSeek). Local: los datos NO salen de la planta.
AI_BASE_URL=                # ej: http://localhost:11434/v1
AI_API_KEY=                 # clave del proveedor (en BD va cifrada; aquí solo fallback)

# === Licenciamiento (L1) ===
# Archivo de licencia firmado (Ed25519/JWS). Sin archivo la app ARRANCA en
# "PENDIENTE DE ACTIVACIÓN" (degradada: solo lectura, jamás crashea) y escribe
# `solicitud.lreq` junto a esta ruta (ceremonia de activación, LICENSING_PROCEDURE §2).
# En dev se genera con `pnpm license:dev` (par DEV committeado en scripts/license/dev-keys;
# la clave pública va EMBEBIDA en el código — NUNCA por variable de entorno).
# En prod el compose lo monta como volumen: /app/license/license.lic.
LICENSE_FILE=.license/license.lic
# Re-evaluación periódica de la licencia, en minutos (def. 360 = 6 h).
LICENSE_RECHECK_MINUTES=360
# Días de anticipación para el aviso POR_VENCER (def. 30).
LICENSE_WARN_DAYS=30
# Señal dominante de la huella node-lock. Bajo Docker DEBE ser el machine-id del
# HOST (el compose lo bind-montea ro); en Windows dev se usa MachineGuid (registro).
LICENSE_MACHINE_ID_FILE=/etc/machine-id

# --- CLI del EMISOR `lyra-license` (L3) — variables de la MÁQUINA DE ITESICWS,
# NO del producto (no van en el .env de una instalación). Se documentan aquí
# solo como referencia; el detalle vive en packages/licensing-cli/README.md:
#   LYRA_LICENSE_HOME             carpeta de custodia (def. ~/.lyra-license):
#                                 prod-private.enc.pem (PKCS#8 CIFRADO) +
#                                 prod-public.pem + ledger.jsonl. FUERA del repo.
#   LYRA_LICENSE_PASSPHRASE       passphrase de la privada (env efímera, para
#                                 automatización; lo normal es el prompt sin eco)
#   LYRA_LICENSE_PASSPHRASE_FILE  ruta a un archivo con la passphrase
# La passphrase JAMÁS se pasa por flag (quedaría en el historial de shell).

# === Producción (Caddy / TLS automático) ===
# SITE_ADDRESS=watchlog.miempresa.cl   # dominio para HTTPS automático; vacío = :80
